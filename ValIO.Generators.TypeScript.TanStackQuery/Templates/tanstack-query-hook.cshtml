@using System.Collections.Generic
@using System.Linq
@using ValIO.Generators.CSharp.Models
@using ValIO.Generators.TypeScript.Models
@using ValIO.Generators.TypeScript.TanStackQuery.Models
@using ValIO.Core.Models
@model TanStackQueryHookTemplateData
@functions {
    string FormatType(TypeInfo typeInfo)
    {
        return typeInfo.FullTypeName;
    }
    
    string GetResponseType(TypeInfo returnTypeInfo)
    {
        if (returnTypeInfo.IsTask && returnTypeInfo.GenericArguments.Count > 0)
        {
            return returnTypeInfo.GenericArguments[0].FullTypeName;
        }
        return returnTypeInfo.FullTypeName;
    }
    
    string FormatParameter(TypeScriptParameterTemplateData param)
    {
        var optional = param.IsRequired ? "" : "?";
        return $"{param.VariableName}{optional}: {FormatType(param.TypeInfo)}";
    }
    
    string BuildPath(string path, IReadOnlyList<TypeScriptParameterTemplateData> pathParams)
    {
        var result = path;
        foreach (var param in pathParams)
        {
            result = result.Replace($"{{{param.Name}}}", $"${{{param.VariableName}}}");
        }
        return result;
    }
    
    string BuildQueryKey(IReadOnlyList<TypeScriptParameterTemplateData> pathParams, IReadOnlyList<TypeScriptParameterTemplateData> queryParams, string path)
    {
        var parts = new List<string> { $"'{path}'" };
        foreach (var param in pathParams)
        {
            parts.Add(param.VariableName);
        }
        foreach (var param in queryParams)
        {
            parts.Add(param.VariableName);
        }
        return $"[{string.Join(", ", parts)}]";
    }
}
@{
    var hookName = Model.HookName;
    var functionName = Model.FunctionName;
    var operation = Model.Operation;
    var operationTemplate = Model.OperationTemplate;
    var options = Model.Options;
    
    var pathParams = operationTemplate.PathParameters;
    var queryParams = operationTemplate.QueryParameters;
    var headerParams = operationTemplate.HeaderParameters;
}
@if (Model.GenerateImports)
{
@if (options.HttpClientLibrary == HttpClientLibrary.Axios)
{
@:import axios, { AxiosInstance, AxiosRequestConfig } from 'axios';
}
@Raw("import { useQuery, UseQueryOptions, UseQueryResult } from '@tanstack/react-query';\n")
@if (Model.ImportedTypes != null && Model.ImportedTypes.Count > 0 && Model.ModelsPath != null)
{
@foreach (var typeName in Model.ImportedTypes)
{
@Raw($"import type {{ {typeName} }} from '{Model.ModelsPath}/{char.ToLowerInvariant(typeName[0]) + typeName.Substring(1)}.model';\n")
}
@:
}
@if (options.ModelFormat == ModelFormat.ValidationSchemas && options.ValidationLibrary == ValidationLibrary.Zod && options.DeserializeWithSchemas && !string.IsNullOrEmpty(Model.ResponseSchemaName))
{
@:import { z } from 'zod';
@if (!string.IsNullOrEmpty(Model.ModelsPath))
{
@Raw($"import {{ {Model.ResponseSchemaName} }} from '{Model.ModelsPath}/{Model.ResponseSchemaFileName}.schema';\n")
}
else
{
@Raw($"import {{ {Model.ResponseSchemaName} }} from '../models/{Model.ResponseSchemaFileName}.schema';\n")
}
}
@:
}

@if (!string.IsNullOrEmpty(operationTemplate.Summary))
{
@Raw("/**\n")
@Raw($" * {operationTemplate.Summary}\n")
@Raw(" */\n")
}
@if (!string.IsNullOrEmpty(operationTemplate.Description))
{
@Raw("/**\n")
@Raw($" * {operationTemplate.Description}\n")
@Raw(" */\n")
}
@Raw($"export const {functionName} = async (\n")
@if (options.HttpClientLibrary == HttpClientLibrary.Axios)
{
@:  axiosInstance: AxiosInstance = axios.create(),
}
@{
    var allParams = new List<string>();
    allParams.AddRange(pathParams.Select(FormatParameter));
    allParams.AddRange(queryParams.Select(FormatParameter));
    allParams.AddRange(headerParams.Select(FormatParameter));
    
    if (operationTemplate.HasRequestBody)
    {
        if (operationTemplate.IsFormData && operationTemplate.FormDataProperties != null && operationTemplate.FormDataProperties.Count > 0)
        {
            foreach (var formProp in operationTemplate.FormDataProperties)
            {
                var optional = formProp.IsRequired ? "" : "?";
                allParams.Add($"{formProp.VariableName}{optional}: {FormatType(formProp.TypeInfo)}");
            }
        }
        else
        {
            var optional = operationTemplate.RequestBodyTypeInfo != null && !operationTemplate.RequestBodyTypeInfo.IsNullable ? "" : "?";
            var typeStr = operationTemplate.RequestBodyTypeInfo != null ? FormatType(operationTemplate.RequestBodyTypeInfo) : "any";
            allParams.Add($"{operationTemplate.RequestBodyParameter}{optional}: {typeStr}");
        }
    }
}
@Raw($"{string.Join(",\n  ", allParams)}\n")
@Raw($"): Promise<{GetResponseType(operationTemplate.ReturnTypeInfo)}> => {{\n")
@if (options.HttpClientLibrary == HttpClientLibrary.Axios)
{
    @:  const path = `@Raw(BuildPath(operationTemplate.Path, pathParams))`;
    @:  const config: AxiosRequestConfig = {
    @:    method: '@operationTemplate.HttpMethod.ToLowerInvariant()',
    @:    url: path,
    @if (queryParams.Count > 0)
    {
    @:    params: {
    @foreach (var queryParam in queryParams)
    {
    @:      @queryParam.Name: @queryParam.VariableName,
    }
    @:    },
    }
    @:    headers: {
    @foreach (var headerParam in headerParams)
    {
    @Raw($"      ...({headerParam.VariableName} !== undefined ? {{ '{headerParam.Name}': {headerParam.VariableName} }} : {{}}),\n")
    }
    @if (operationTemplate.HasRequestBody)
    {
        @if (operationTemplate.IsFormData && operationTemplate.FormDataProperties != null && operationTemplate.FormDataProperties.Count > 0)
        {
    @:      'Content-Type': 'multipart/form-data',
        }
        else
        {
    @Raw($"      'Content-Type': '{operationTemplate.RequestBodyContentType ?? "application/json"}',\n")
        }
    }
    @:    },
    @if (operationTemplate.HasRequestBody)
    {
        @if (operationTemplate.IsFormData && operationTemplate.FormDataProperties != null && operationTemplate.FormDataProperties.Count > 0)
        {
    @:    data: (() => {
    @:      const formData = new FormData();
    @foreach (var formProp in operationTemplate.FormDataProperties)
    {
        @if (formProp.IsRequired)
        {
    @:      formData.append('@formProp.Name', @formProp.VariableName);
        }
        else
        {
    @:      if (@formProp.VariableName !== undefined) {
    @:        formData.append('@formProp.Name', @formProp.VariableName);
    @:      }
        }
    }
    @:      return formData;
    @:    })(),
        }
        else
        {
    @:    data: @operationTemplate.RequestBodyParameter,
        }
    }
    @:  };
    @:
    @Raw($"  const response = await axiosInstance.request<{GetResponseType(operationTemplate.ReturnTypeInfo)}>(config);\n")
    @if (operationTemplate.ReturnTypeInfo.IsTask && operationTemplate.ReturnTypeInfo.GenericArguments.Count > 0 && !operationTemplate.ReturnTypeInfo.GenericArguments[0].IsVoid)
    {
    @:  return response.data;
    }
    else
    {
    @:  return;
    }
}
else
{
    @:  const path = `@Raw(BuildPath(operationTemplate.Path, pathParams))`;
    @if (queryParams.Count > 0)
    {
    @:  const queryParamsStr = [
    @foreach (var queryParam in queryParams)
    {
        @if (queryParam.IsRequired)
        {
    @Raw($"    `{queryParam.Name}=${{{queryParam.VariableName}}}`,\n")
        }
        else
        {
    @Raw($"    {queryParam.VariableName} !== undefined ? `{queryParam.Name}=${{{queryParam.VariableName}}}` : null,\n")
        }
    }
    @:  ].filter(Boolean).join('&');
    @:  const url = queryParamsStr ? `${path}?${queryParamsStr}` : path;
    }
    else
    {
    @:  const url = path;
    }
    @:  const headers: Record<string, string> = {};
    @foreach (var headerParam in headerParams)
    {
    @:  if (@headerParam.VariableName !== undefined) {
    @:    headers['@headerParam.Name'] = @headerParam.VariableName;
    @:  }
    }
    @if (operationTemplate.HasRequestBody)
    {
        @if (operationTemplate.IsFormData && operationTemplate.FormDataProperties != null && operationTemplate.FormDataProperties.Count > 0)
        {
    @:  const formData = new FormData();
    @foreach (var formProp in operationTemplate.FormDataProperties)
    {
        @if (formProp.IsRequired)
        {
    @:  formData.append('@formProp.Name', @formProp.VariableName);
        }
        else
        {
    @:  if (@formProp.VariableName !== undefined) {
    @:    formData.append('@formProp.Name', @formProp.VariableName);
    @:  }
        }
    }
    @:  const response = await fetch(url, {
    @:    method: '@operationTemplate.HttpMethod',
    @:    headers,
    @:    body: formData
    @:  });
        }
        else
        {
    @Raw($"  headers['Content-Type'] = '{operationTemplate.RequestBodyContentType ?? "application/json"}';\n")
    @:  const response = await fetch(url, {
    @:    method: '@operationTemplate.HttpMethod',
    @:    headers,
    @:    body: JSON.stringify(@operationTemplate.RequestBodyParameter)
    @:  });
        }
    }
    else
    {
    @:  const response = await fetch(url, {
    @:    method: '@operationTemplate.HttpMethod',
    @:    headers
    @:  });
    }
    @if (operationTemplate.ReturnTypeInfo.IsTask && operationTemplate.ReturnTypeInfo.GenericArguments.Count > 0 && !operationTemplate.ReturnTypeInfo.GenericArguments[0].IsVoid)
    {
    @:  if (!response.ok) {
    @Raw($"    throw new Error(`HTTP error! status: ${{response.status}}`);\n")
    @:  }
    @Raw($"  return await response.json() as {GetResponseType(operationTemplate.ReturnTypeInfo)};\n")
    }
    else
    {
    @Raw("  if (!response.ok) {\n")
    @Raw("    throw new Error(`HTTP error! status: ${response.status}`);\n")
    @Raw("  }\n")
    @:  return;
    }
}
@Raw("};\n")
@Raw("\n")
@Raw($"export const {Model.QueryKeyFunctionName} = (\n")
@{
    var keyParams = new List<string>();
    keyParams.AddRange(pathParams.Select(FormatParameter));
    keyParams.AddRange(queryParams.Select(FormatParameter));
}
@{
    var keyParamsStr = string.Join(",\n  ", keyParams);
}
@Raw($"{keyParamsStr}\n")
@Raw($") => {{\n")
@Raw($"  return {BuildQueryKey(pathParams, queryParams, operationTemplate.Path)};\n")
@Raw("};\n")

@{
    var hookParams = new List<string>();
    hookParams.AddRange(pathParams.Select(FormatParameter));
    hookParams.AddRange(queryParams.Select(FormatParameter));
    var hookParamsStr = string.Join(",\n  ", hookParams);
    var returnType = GetResponseType(operationTemplate.ReturnTypeInfo);
    var axiosOption = options.HttpClientLibrary == HttpClientLibrary.Axios ? "    axios?: AxiosRequestConfig;" : "    fetch?: RequestInit;";
}
@Raw($"export const {hookName} = <\n")
@Raw($"  TData = {returnType},\n")
@Raw($"  TError = Error,\n")
@Raw($">(\n")
@Raw($"{hookParamsStr}\n")
@Raw($"  options?: {{\n")
@Raw($"    query?: UseQueryOptions<{returnType}, TError, TData>;\n")
@Raw($"{axiosOption}\n")
@Raw($"  }},\n")
@Raw($"): UseQueryResult<TData, TError> => {{\n")
@{
    var destructuringOption = options.HttpClientLibrary == HttpClientLibrary.Axios ? ", axios: axiosOptions" : ", fetch: fetchOptions";
}
@Raw($"  const {{ query: queryOptions{destructuringOption} }} = options ?? {{}};\n")
@Raw("\n")
@{
    var keyArgs = new List<string>();
    keyArgs.AddRange(pathParams.Select(p => p.VariableName));
    keyArgs.AddRange(queryParams.Select(p => p.VariableName));
    var keyArgsStr = string.Join(", ", keyArgs);
}
@Raw($"  const queryKey = queryOptions?.queryKey ?? {Model.QueryKeyFunctionName}({keyArgsStr});\n")
@Raw("\n")
@{
    var fnArgs = new List<string>();
    fnArgs.AddRange(pathParams.Select(p => p.VariableName));
    fnArgs.AddRange(queryParams.Select(p => p.VariableName));
    fnArgs.AddRange(headerParams.Select(p => p.VariableName));
    if (operationTemplate.HasRequestBody)
    {
        if (operationTemplate.IsFormData && operationTemplate.FormDataProperties != null && operationTemplate.FormDataProperties.Count > 0)
        {
            fnArgs.AddRange(operationTemplate.FormDataProperties.Select(p => p.VariableName));
        }
        else
        {
            fnArgs.Add(operationTemplate.RequestBodyParameter);
        }
    }
    var fnArgsStr = string.Join(",\n      ", fnArgs);
}
@Raw("  const queryFn = async () => {\n")
@if (options.ModelFormat == ModelFormat.ValidationSchemas && options.ValidationLibrary == ValidationLibrary.Zod && options.DeserializeWithSchemas)
{
    @:    const response = await @(functionName)(
    @if (options.HttpClientLibrary == HttpClientLibrary.Axios)
    {
    @:      axios.create(),
    }
    @Raw(fnArgsStr)
    @:    );
    @:    // Десериализация и валидация через Zod схему
    @:    const schema = @(Model.ResponseSchemaName);
    @:    return schema.parse(response);
}
else
{
    @:    return await @(functionName)(
    @if (options.HttpClientLibrary == HttpClientLibrary.Axios)
    {
    @:      axios.create(),
    }
    @Raw(fnArgsStr)
    @:    );
}
@Raw("  };\n")
@Raw("\n")
@{
    var queryReturnType = GetResponseType(operationTemplate.ReturnTypeInfo);
}
@Raw($"  const query = useQuery<{queryReturnType}, TError, TData>(\n")
@Raw("    queryKey,\n")
@Raw("    queryFn,\n")
@Raw("    {\n")
@Raw("      enabled: true,\n")
@Raw("      ...queryOptions,\n")
@Raw("    },\n")
@Raw("  );\n")
@Raw("\n")
@Raw("  return {\n")
@Raw("    queryKey,\n")
@Raw("    ...query,\n")
@Raw("  };\n")
@Raw("};\n")
