@using System.Collections.Generic
@using System.Linq
@using ValIO.Generators.CSharp.Models
@using ValIO.Generators.TypeScript.Models
@using ValIO.Generators.TypeScript.TanStackQuery.Models
@using ValIO.Core.Models
@model TanStackQueryHookTemplateData
@functions {
    string FormatType(TypeInfo typeInfo)
    {
        return typeInfo.FullTypeName;
    }
    
    string GetResponseType(TypeInfo returnTypeInfo)
    {
        if (returnTypeInfo.IsTask && returnTypeInfo.GenericArguments.Count > 0)
        {
            return returnTypeInfo.GenericArguments[0].FullTypeName;
        }
        return returnTypeInfo.FullTypeName;
    }
    
    string FormatParameter(TypeScriptParameterTemplateData param)
    {
        var optional = param.IsRequired ? "" : "?";
        var typeName = FormatType(param.TypeInfo);
        return $"{param.VariableName}{optional}: {typeName}";
    }
    
    string BuildPath(string path, IReadOnlyList<TypeScriptParameterTemplateData> pathParams)
    {
        var result = path;
        foreach (var param in pathParams)
        {
            result = result.Replace($"{{{param.Name}}}", $"${{{param.VariableName}}}");
        }
        return result;
    }
}
@{
    var hookName = Model.HookName;
    var functionName = Model.FunctionName;
    var operation = Model.Operation;
    var operationTemplate = Model.OperationTemplate;
    var options = Model.Options;
    
    // Имя метода клиента (используем импортированный метод, если указан, иначе используем functionName для обратной совместимости)
    var clientMethodName = !string.IsNullOrEmpty(Model.ClientMethodName) ? Model.ClientMethodName : functionName;
    
    // Имена типов для ReturnType и AwaitedReturnType
    var returnTypeName = char.ToUpperInvariant(clientMethodName[0]) + clientMethodName.Substring(1) + "ReturnType";
    var awaitedReturnTypeName = char.ToUpperInvariant(clientMethodName[0]) + clientMethodName.Substring(1) + "AwaitedReturnType";
    
    var pathParams = operationTemplate.PathParameters;
    var queryParams = operationTemplate.QueryParameters;
    var headerParams = operationTemplate.HeaderParameters;
}

@if (!string.IsNullOrEmpty(operationTemplate.Summary))
{
@Raw("/**\n")
@Raw($" * {operationTemplate.Summary}\n")
@Raw(" */\n")
}
@if (!string.IsNullOrEmpty(operationTemplate.Description))
{
@Raw("/**\n")
@Raw($" * {operationTemplate.Description}\n")
@Raw(" */\n")
}
@* Определяем функцию клиента только если ClientMethodName не указан (обратная совместимость) *@
@if (string.IsNullOrEmpty(Model.ClientMethodName))
{
@Raw($"export const {functionName} = async (\n")
@if (options.HttpClientLibrary == HttpClientLibrary.Axios)
{
@Raw("  axiosInstance: AxiosInstance,\n")
}
    // Разделяем параметры на required и optional для правильного порядка
    var requiredParams = new List<string>();
    var optionalParams = new List<string>();
    
    // Path parameters всегда required
    requiredParams.AddRange(pathParams.Select(FormatParameter));
    
    // Query parameters могут быть required или optional
    foreach (var param in queryParams)
    {
        if (param.IsRequired)
        {
            requiredParams.Add(FormatParameter(param));
        }
        else
        {
            optionalParams.Add(FormatParameter(param));
        }
    }
    
    // Header parameters могут быть required или optional
    foreach (var param in headerParams)
    {
        if (param.IsRequired)
        {
            requiredParams.Add(FormatParameter(param));
        }
        else
        {
            optionalParams.Add(FormatParameter(param));
        }
    }
    
    // Request body
    if (operationTemplate.HasRequestBody)
    {
        if (operationTemplate.IsFormData && operationTemplate.FormDataProperties != null && operationTemplate.FormDataProperties.Count > 0)
        {
            foreach (var formProp in operationTemplate.FormDataProperties)
            {
                var optional = formProp.IsRequired ? "" : "?";
                var paramStr = $"{formProp.VariableName}{optional}: {FormatType(formProp.TypeInfo)}";
                if (formProp.IsRequired)
                {
                    requiredParams.Add(paramStr);
                }
                else
                {
                    optionalParams.Add(paramStr);
                }
            }
        }
        else
        {
            var optional = operationTemplate.RequestBodyTypeInfo != null && !operationTemplate.RequestBodyTypeInfo.IsNullable ? "" : "?";
            var typeStr = operationTemplate.RequestBodyTypeInfo != null ? FormatType(operationTemplate.RequestBodyTypeInfo) : "any";
            var paramStr = $"{operationTemplate.RequestBodyParameter}{optional}: {typeStr}";
            if (operationTemplate.RequestBodyTypeInfo == null || operationTemplate.RequestBodyTypeInfo.IsNullable)
            {
                optionalParams.Add(paramStr);
            }
            else
            {
                requiredParams.Add(paramStr);
            }
        }
    }
    
    // Объединяем: сначала required, потом optional
    var allParams = new List<string>();
    allParams.AddRange(requiredParams);
    allParams.AddRange(optionalParams);
@Raw($"{string.Join(",\n  ", allParams)}\n")
@Raw($"): Promise<{GetResponseType(operationTemplate.ReturnTypeInfo)}> => {{\n")
@if (options.HttpClientLibrary == HttpClientLibrary.Axios)
{
    @Raw($"  const path = `{BuildPath(operationTemplate.Path, pathParams)}`;\n")
    @Raw("  const config: AxiosRequestConfig = {\n")
    @Raw($"    method: '{operationTemplate.HttpMethod.ToLowerInvariant()}',\n")
    @Raw("    url: path,\n")
    @if (queryParams.Count > 0)
    {
    @Raw("    params: {\n")
    @foreach (var queryParam in queryParams)
    {
    @Raw($"      {queryParam.Name}: {queryParam.VariableName},\n")
    }
    @Raw("    },\n")
    }
    @Raw("    headers: {\n")
    @foreach (var headerParam in headerParams)
    {
    @Raw($"      ...({headerParam.VariableName} !== undefined ? {{ '{headerParam.Name}': {headerParam.VariableName} }} : {{}}),\n")
    }
    @if (operationTemplate.HasRequestBody)
    {
        @if (operationTemplate.IsFormData && operationTemplate.FormDataProperties != null && operationTemplate.FormDataProperties.Count > 0)
        {
    @Raw("      'Content-Type': 'multipart/form-data',\n")
        }
        else
        {
    @Raw($"      'Content-Type': '{operationTemplate.RequestBodyContentType ?? "application/json"}',\n")
        }
    }
    @Raw("    },\n")
    @if (operationTemplate.HasRequestBody)
    {
        @if (operationTemplate.IsFormData && operationTemplate.FormDataProperties != null && operationTemplate.FormDataProperties.Count > 0)
        {
    @Raw("    data: (() => {\n")
    @Raw("      const formData = new FormData();\n")
    @foreach (var formProp in operationTemplate.FormDataProperties)
    {
        @if (formProp.IsRequired)
        {
    @Raw($"      formData.append('{formProp.Name}', {formProp.VariableName});\n")
        }
        else
        {
    @Raw($"      if ({formProp.VariableName} !== undefined) {{\n")
    @Raw($"        formData.append('{formProp.Name}', {formProp.VariableName});\n")
    @Raw("      }\n")
        }
    }
    @Raw("      return formData;\n")
    @Raw("    })(),\n")
        }
        else
        {
    @Raw($"    data: {operationTemplate.RequestBodyParameter},\n")
        }
    }
    @Raw("  };\n")
    @Raw("\n")
    @Raw($"  const response = await axiosInstance.request<{GetResponseType(operationTemplate.ReturnTypeInfo)}>(config);\n")
    @if (operationTemplate.ReturnTypeInfo.IsTask && operationTemplate.ReturnTypeInfo.GenericArguments.Count > 0 && !operationTemplate.ReturnTypeInfo.GenericArguments[0].IsVoid)
    {
    @Raw("  return response.data;\n")
    }
    else
    {
    @Raw("  return;\n")
    }
}
else
{
    @Raw($"  const path = `{BuildPath(operationTemplate.Path, pathParams)}`;\n")
    @if (queryParams.Count > 0)
    {
    @Raw("  const queryParamsStr = [\n")
    @foreach (var queryParam in queryParams)
    {
        @if (queryParam.IsRequired)
        {
    @Raw($"    `{queryParam.Name}=${{{queryParam.VariableName}}}`,\n")
        }
        else
        {
    @Raw($"    {queryParam.VariableName} !== undefined ? `{queryParam.Name}=${{{queryParam.VariableName}}}` : null,\n")
        }
    }
    @Raw("  ].filter(Boolean).join('&');\n")
    @Raw("  const url = queryParamsStr ? `${path}?${queryParamsStr}` : path;\n")
    }
    else
    {
    @Raw("  const url = path;\n")
    }
    @Raw("  const headers: Record<string, string> = {};\n")
    @foreach (var headerParam in headerParams)
    {
    @Raw($"  if ({headerParam.VariableName} !== undefined) {{\n")
    @Raw($"    headers['{headerParam.Name}'] = {headerParam.VariableName};\n")
    @Raw("  }\n")
    }
    @if (operationTemplate.HasRequestBody)
    {
        @if (operationTemplate.IsFormData && operationTemplate.FormDataProperties != null && operationTemplate.FormDataProperties.Count > 0)
        {
    @Raw("  const formData = new FormData();\n")
    @foreach (var formProp in operationTemplate.FormDataProperties)
    {
        @if (formProp.IsRequired)
        {
    @Raw($"  formData.append('{formProp.Name}', {formProp.VariableName});\n")
        }
        else
        {
    @Raw($"  if ({formProp.VariableName} !== undefined) {{\n")
    @Raw($"    formData.append('{formProp.Name}', {formProp.VariableName});\n")
    @Raw("  }\n")
        }
    }
    @Raw("  const response = await fetch(url, {\n")
    @Raw($"    method: '{operationTemplate.HttpMethod}',\n")
    @Raw("    headers,\n")
    @Raw("    body: formData\n")
    @Raw("  });\n")
        }
        else
        {
    @Raw($"  headers['Content-Type'] = '{operationTemplate.RequestBodyContentType ?? "application/json"}';\n")
    @Raw("  const response = await fetch(url, {\n")
    @Raw($"    method: '{operationTemplate.HttpMethod}',\n")
    @Raw("    headers,\n")
    @Raw($"    body: JSON.stringify({operationTemplate.RequestBodyParameter})\n")
    @Raw("  });\n")
        }
    }
    else
    {
    @Raw("  const response = await fetch(url, {\n")
    @Raw($"    method: '{operationTemplate.HttpMethod}',\n")
    @Raw("    headers\n")
    @Raw("  });\n")
    }
    @if (operationTemplate.ReturnTypeInfo.IsTask && operationTemplate.ReturnTypeInfo.GenericArguments.Count > 0 && !operationTemplate.ReturnTypeInfo.GenericArguments[0].IsVoid)
    {
    @Raw("  if (!response.ok) {\n")
    @Raw("    throw new Error(`HTTP error! status: ${response.status}`);\n")
    @Raw("  }\n")
    @Raw($"  const data = await response.json() as {GetResponseType(operationTemplate.ReturnTypeInfo)};\n")
    @Raw("  return data;\n")
    }
    else
    {
    @Raw("  if (!response.ok) {\n")
    @Raw("    throw new Error(`HTTP error! status: ${response.status}`);\n")
    @Raw("  }\n")
    @Raw("  return;\n")
    }
}
@Raw("};\n")
@Raw("\n")
}
@{
    // Проверяем, используется ли custom axios instance (определяем в начале блока, чтобы была доступна везде)
    var hasCustomAxiosInstance = options.HttpClientLibrary == HttpClientLibrary.Axios && 
        options.Axios != null && 
        !string.IsNullOrEmpty(options.Axios.CustomInstancePath) && 
        !string.IsNullOrEmpty(options.Axios.CustomInstanceName);
    
    // Формируем TVariables - объект с полями параметров
    var mutationVars = new List<string>();
    mutationVars.AddRange(pathParams.Select(FormatParameter));
    
    // Query parameters: либо как модель, либо как отдельные параметры
    if (operationTemplate.UseQueryParametersModel && !string.IsNullOrEmpty(operationTemplate.QueryParametersModelTypeName))
    {
        var modelTypeName = operationTemplate.QueryParametersModelTypeName;
        var hasRequiredParam = queryParams.Any(p => p.IsRequired);
        var optional = hasRequiredParam ? "" : "?";
        mutationVars.Add($"params{optional}: {modelTypeName}");
    }
    else
    {
        mutationVars.AddRange(queryParams.Select(FormatParameter));
    }
    
    mutationVars.AddRange(headerParams.Select(FormatParameter));
    if (operationTemplate.HasRequestBody)
    {
        if (operationTemplate.IsFormData && operationTemplate.FormDataProperties != null && operationTemplate.FormDataProperties.Count > 0)
        {
            foreach (var formProp in operationTemplate.FormDataProperties)
            {
                var optional = formProp.IsRequired ? "" : "?";
                mutationVars.Add($"{formProp.VariableName}{optional}: {FormatType(formProp.TypeInfo)}");
            }
        }
        else
        {
            var optional = operationTemplate.RequestBodyTypeInfo != null && !operationTemplate.RequestBodyTypeInfo.IsNullable ? "" : "?";
            var typeStr = operationTemplate.RequestBodyTypeInfo != null ? FormatType(operationTemplate.RequestBodyTypeInfo) : "any";
            // В orval для request body используется "data", но мы используем RequestBodyParameter
            mutationVars.Add($"{operationTemplate.RequestBodyParameter}{optional}: {typeStr}");
        }
    }
    var mutationVarsStr = mutationVars.Count > 0 ? "    " + string.Join(";\n    ", mutationVars) : "";
    
    // Формируем опции для axios или fetch
    var axiosOptions = new List<string>();
    if (options.HttpClientLibrary == HttpClientLibrary.Axios)
    {
        axiosOptions.Add("    timeout?: number;");
        if (hasCustomAxiosInstance)
        {
            axiosOptions.Add("    axiosInstance?: AxiosInstance;");
        }
    }
    else
    {
        axiosOptions.Add("    timeout?: number;");
        axiosOptions.Add("    fetch?: RequestInit;");
    }
    var axiosOptionStr = string.Join("\n", axiosOptions);
    
    var functionNamePascal = char.ToUpperInvariant(clientMethodName[0]) + clientMethodName.Substring(1);
    var mutationOptionsFunctionName = $"get{functionNamePascal}MutationOptions";
    var responseType = GetResponseType(operationTemplate.ReturnTypeInfo);
    
    // Формируем деструктуризацию variables для mutationFn - это список имен полей для деструктуризации
    var mutationFnVarProps = new List<string>();
    mutationFnVarProps.AddRange(pathParams.Select(p => p.VariableName));
    
    // Query parameters: если используется модель, передаем params, иначе отдельные параметры
    if (operationTemplate.UseQueryParametersModel && !string.IsNullOrEmpty(operationTemplate.QueryParametersModelTypeName))
    {
        mutationFnVarProps.Add("params");
    }
    else
    {
        mutationFnVarProps.AddRange(queryParams.Select(p => p.VariableName));
    }
    
    mutationFnVarProps.AddRange(headerParams.Select(p => p.VariableName));
    if (operationTemplate.HasRequestBody)
    {
        if (operationTemplate.IsFormData && operationTemplate.FormDataProperties != null && operationTemplate.FormDataProperties.Count > 0)
        {
            mutationFnVarProps.AddRange(operationTemplate.FormDataProperties.Select(p => p.VariableName));
        }
        else
        {
            mutationFnVarProps.Add(operationTemplate.RequestBodyParameter);
        }
    }
    var mutationFnVarPropsStr = string.Join(", ", mutationFnVarProps);
    
    // Формируем аргументы для вызова клиентского метода - разделяем на required и optional для правильного порядка
    var requiredClientMethodArgs = new List<string>();
    var optionalClientMethodArgs = new List<string>();
    
    // Path parameters всегда required
    requiredClientMethodArgs.AddRange(pathParams.Select(p => p.VariableName));
    
    // Query parameters: если используется модель, передаем params, иначе отдельные параметры
    if (operationTemplate.UseQueryParametersModel && !string.IsNullOrEmpty(operationTemplate.QueryParametersModelTypeName))
    {
        var hasRequiredParam = queryParams.Any(p => p.IsRequired);
        if (hasRequiredParam)
        {
            requiredClientMethodArgs.Add("params");
        }
        else
        {
            optionalClientMethodArgs.Add("params");
        }
    }
    else
    {
        foreach (var param in queryParams)
        {
            if (param.IsRequired)
            {
                requiredClientMethodArgs.Add(param.VariableName);
            }
            else
            {
                optionalClientMethodArgs.Add(param.VariableName);
            }
        }
    }
    
    // Header parameters могут быть required или optional
    foreach (var param in headerParams)
    {
        if (param.IsRequired)
        {
            requiredClientMethodArgs.Add(param.VariableName);
        }
        else
        {
            optionalClientMethodArgs.Add(param.VariableName);
        }
    }
    
    // Request body
    if (operationTemplate.HasRequestBody)
    {
        if (operationTemplate.IsFormData && operationTemplate.FormDataProperties != null && operationTemplate.FormDataProperties.Count > 0)
        {
            foreach (var formProp in operationTemplate.FormDataProperties)
            {
                if (formProp.IsRequired)
                {
                    requiredClientMethodArgs.Add(formProp.VariableName);
                }
                else
                {
                    optionalClientMethodArgs.Add(formProp.VariableName);
                }
            }
        }
        else
        {
            // RequestBody может быть required или optional в зависимости от IsNullable
            if (operationTemplate.RequestBodyTypeInfo == null || operationTemplate.RequestBodyTypeInfo.IsNullable)
            {
                optionalClientMethodArgs.Add(operationTemplate.RequestBodyParameter);
            }
            else
            {
                requiredClientMethodArgs.Add(operationTemplate.RequestBodyParameter);
            }
        }
    }
    
    // axiosInstance, signal, timeout - все optional
    if (hasCustomAxiosInstance)
    {
        optionalClientMethodArgs.Add("requestOptions");
    }
    
    // Объединяем: сначала required, потом optional
    var clientMethodArgs = new List<string>();
    clientMethodArgs.AddRange(requiredClientMethodArgs);
    clientMethodArgs.AddRange(optionalClientMethodArgs);
    var clientMethodArgsStr = string.Join(", ", clientMethodArgs);
}
@Raw($"export const {mutationOptionsFunctionName} = <\n  TError = Error,\n  TContext = unknown,\n>(options?: {{\n  mutation?: UseMutationOptions<\n    {awaitedReturnTypeName},\n    TError,\n    {{\n{mutationVarsStr}\n    }},\n    TContext\n  >;\n{axiosOptionStr}\n}}): UseMutationOptions<\n  {awaitedReturnTypeName},\n  TError,\n  {{\n{mutationVarsStr}\n  }},\n  TContext\n> => {{\n")
@Raw($"  const mutationKey = [\"{clientMethodName}\"];\n")
@{
    var hasCustomAxiosInstanceForTemplate = options.HttpClientLibrary == HttpClientLibrary.Axios && 
        options.Axios != null && 
        !string.IsNullOrEmpty(options.Axios.CustomInstancePath) && 
        !string.IsNullOrEmpty(options.Axios.CustomInstanceName);
}
@Raw("  const { mutation: mutationOptions")
@if (hasCustomAxiosInstanceForTemplate)
{
@Raw(", axiosInstance: requestOptions")
}
@Raw(" } = options\n")
@Raw("    ? options.mutation &&\n")
@Raw("      \"mutationKey\" in options.mutation &&\n")
@Raw("      options.mutation.mutationKey\n")
@Raw("      ? options\n")
@Raw("      : { ...options, mutation: { ...options.mutation, mutationKey } }\n")
@Raw("    : { mutation: { mutationKey }")
@if (hasCustomAxiosInstanceForTemplate)
{
@Raw(", axiosInstance: undefined")
}
@Raw(" };\n")
@Raw("\n")
@Raw("  const mutationFn: MutationFunction<\n")
@Raw($"    {awaitedReturnTypeName},\n")
@Raw("    {\n")
@Raw($"{mutationVarsStr}\n")
@Raw("    }\n")
@Raw("  > = (props) => {\n")
@Raw($"    const {{ {mutationFnVarPropsStr} }} = props ?? {{}};\n")
@Raw("\n")
@Raw($"    return {clientMethodName}({clientMethodArgsStr});\n")
@Raw("  };\n")
@Raw("\n")
@Raw("  return { mutationFn, ...mutationOptions };\n")
@Raw("};\n")
@Raw("\n")
@if (!string.IsNullOrEmpty(operationTemplate.Summary))
{
@Raw("/**\n")
@Raw($" * {operationTemplate.Summary}\n")
@Raw(" */\n")
}
@Raw($"export const {hookName} = <\n  TError = Error,\n  TContext = unknown,\n>(\n  options?: {{\n    mutation?: UseMutationOptions<\n      {awaitedReturnTypeName},\n      TError,\n      {{\n{mutationVarsStr}\n      }},\n      TContext\n    >;\n{axiosOptionStr}\n  }},\n  queryClient?: QueryClient,\n): UseMutationResult<\n  {awaitedReturnTypeName},\n  TError,\n  {{\n{mutationVarsStr}\n  }},\n  TContext\n> => {{\n")
@Raw($"  const mutationOptions = {mutationOptionsFunctionName}(options);\n")
@Raw("\n")
@Raw("  return useMutation(mutationOptions, queryClient);\n")
@Raw("};\n")
