{
  "swagger": "2.0",
  "info": {
    "title": "Parser matrix",
    "version": "1.0.0"
  },
  "paths": {
    "/items": {
      "post": {
        "operationId": "createItem",
        "tags": [
          "Items"
        ],
        "responses": {
          "200": {
            "description": "Accepted item.",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/Base"
                }
              ]
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/Base"
                }
              ]
            }
          }
        ]
      }
    }
  },
  "host": "api.example.test",
  "schemes": [
    "https"
  ],
  "basePath": "/v1",
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "definitions": {
    "Base": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "base"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24,
          "description": "A constrained label."
        }
      }
    },
    "State": {
      "type": "string",
      "enum": [
        "ready",
        "done"
      ]
    },
    "Alternative": {
      "type": "object",
      "required": [
        "kind",
        "count"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "alternative"
          ]
        },
        "count": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "Choice": {
      "allOf": [
        {
          "$ref": "#/definitions/Base"
        },
        {
          "type": "object",
          "properties": {
            "extra": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
