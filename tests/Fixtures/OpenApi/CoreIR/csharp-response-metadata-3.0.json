{
  "openapi": "3.0.3",
  "info": { "title": "Receipt response metadata", "version": "1" },
  "paths": {
    "/api/v1/receipts/{id}": {
      "get": {
        "operationId": "FindReceipt",
        "tags": ["Receipts"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "The receipt is available.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Receipt" } } }
          },
          "400": {
            "description": "The request is invalid.",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ReceiptProblem" } } }
          },
          "404": {
            "description": "The owner does not have the receipt.",
            "headers": {
              "Cache-Control": { "description": "Read directly from the owner.", "required": true, "schema": { "type": "string", "enum": ["no-store"] } }
            }
          },
          "409": {
            "description": "A published receipt rejects the operation.",
            "content": {
              "text/html": {},
              "application/json": { "schema": { "$ref": "#/components/schemas/Receipt" } }
            }
          }
        }
      }
    },
    "/api/v1/receipts/{id}/wins": {
      "get": {
        "operationId": "ReadWins",
        "tags": ["Receipts"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "The complete page of up to 500 financial facts.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WinPage" } } }
          }
        }
      }
    },
    "/api/v1/receipts": {
      "get": {
        "operationId": "ReadOrdinary",
        "tags": ["Receipts"],
        "responses": {
          "204": { "description": "An ordinary operation without metadata enabled." }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Receipt": {
        "type": "object",
        "required": ["revision", "amount", "accepted"],
        "properties": {
          "revision": { "type": "integer", "format": "int64" },
          "amount": { "type": "number", "format": "decimal" },
          "accepted": { "type": "boolean" }
        }
      },
      "ReceiptProblem": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": { "type": "string" }
        }
      },
      "WinPage": {
        "type": "object",
        "required": ["entries"],
        "properties": {
          "entries": { "type": "array", "maxItems": 500, "items": { "$ref": "#/components/schemas/WinFact" } }
        }
      },
      "WinFact": {
        "type": "object",
        "required": [
          "winId", "sequence", "journalEntryId", "amount", "restricted", "observedAt", "postedAt",
          "reversalId", "reversalSequence", "reversalJournalEntryId", "reversalRestricted"
        ],
        "properties": {
          "winId": { "type": "string", "format": "uuid" },
          "sequence": { "type": "integer", "format": "int64" },
          "journalEntryId": { "type": "string", "format": "uuid" },
          "amount": { "type": "number", "format": "decimal" },
          "restricted": { "type": "boolean" },
          "observedAt": { "type": "string", "format": "date-time" },
          "postedAt": { "type": "string", "format": "date-time" },
          "reversalId": { "type": "string", "format": "uuid" },
          "reversalSequence": { "type": "integer", "format": "int64" },
          "reversalJournalEntryId": { "type": "string", "format": "uuid" },
          "reversalRestricted": { "type": "boolean" }
        }
      }
    }
  }
}
