<Project>
  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.targets" />

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Shared\FixtureFile.cs" Link="Fixtures\FixtureFile.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared\OpenApiFixture.cs" Link="Fixtures\OpenApiFixture.cs" />
    <None Include="$(MSBuildThisFileDirectory)Fixtures\**\*"
          Link="Fixtures\%(RecursiveDir)%(Filename)%(Extension)"
          TargetPath="Fixtures\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
