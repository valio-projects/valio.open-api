{
  "openapi": "3.0.3",
  "info": {
    "title": "UUID Test API",
    "version": "1.0.0"
  },
  "paths": {
    "/documents/{id}": {
      "get": {
        "operationId": "getDocumentById",
        "summary": "Get a document by id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "A document",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Document" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Document": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string" }
        },
        "required": ["id", "title"]
      }
    }
  }
}
