{
  "openapi": "3.0.3",
  "info": {
    "title": "Enum Query Param API",
    "version": "1.0.0"
  },
  "paths": {
    "/users": {
      "get": {
        "operationId": "listUsers",
        "summary": "List users filtered by role",
        "parameters": [
          {
            "name": "role",
            "in": "query",
            "required": false,
            "schema": { "$ref": "#/components/schemas/UserRole" }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserRole": {
        "type": "string",
        "enum": ["admin", "user", "guest"]
      }
    }
  }
}
