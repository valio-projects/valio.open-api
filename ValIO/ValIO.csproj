<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PreserveCompilationContext>true</PreserveCompilationContext>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.1" />
      <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.1" />
      <PackageReference Include="Microsoft.OpenApi" Version="3.1.1" />
      <PackageReference Include="System.CommandLine" Version="2.0.1" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ValIO.Core\ValIO.Core.csproj" />
      <ProjectReference Include="..\ValIO.Parsers\ValIO.Parsers.csproj" />
      <ProjectReference Include="..\ValIO.Configuration\ValIO.Configuration.csproj" />
      <ProjectReference Include="..\ValIO.Generators.CSharp\ValIO.Generators.CSharp.csproj" />
      <ProjectReference Include="..\ValIO.Generators.TypeScript\ValIO.Generators.TypeScript.csproj" />
      <ProjectReference Include="..\ValIO.Generators.Cpp\ValIO.Generators.Cpp.csproj" />
      <ProjectReference Include="..\ValIO.Generators.Php\ValIO.Generators.Php.csproj" />
      <ProjectReference Include="..\ValIO.Generators.Python\ValIO.Generators.Python.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\valio.config.json">
        <Link>valio.config.json</Link>
      </Content>
      <Content Include="..\valio.config.typescript.example.json">
        <Link>valio.config.typescript.example.json</Link>
      </Content>
    </ItemGroup>

</Project>
