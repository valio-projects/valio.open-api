@using ValIO.Generators.TypeScript.Models
@using ValIO.Generators.TypeScript.Zod.Models
@using System.Linq
@model ZodEnumSchemaTemplateData
@{
    var schemaName = Model.SchemaName;
    var typeName = Model.TypeName;
    var enumValues = Model.EnumValues;
    var description = Model.Description;
    var underlyingType = Model.UnderlyingType ?? "string";
    var isStringEnum = underlyingType == "string";
    var constArrayName = $"{typeName}Values";
    var satisfiesType = isStringEnum ? "readonly string[]" : "readonly number[]";
}
import { z } from 'zod';

@if (isStringEnum)
{
@:export const @constArrayName = [
@foreach (var enumValue in enumValues)
{
    @:@Raw(enumValue)@(enumValue == enumValues.Last() ? "" : ",")
}
@:] as const satisfies readonly string[];
@:
@if (!string.IsNullOrEmpty(description))
{
@:/**
@: * @Raw(description)
@: */
}
@:export const @schemaName = z.enum(@constArrayName);
}
else
{
@:// Числовые enum'ы в Zod требуют использования z.union с z.literal
@:export const @constArrayName = [
@foreach (var enumValue in enumValues)
{
    @:@Raw(enumValue)@(enumValue == enumValues.Last() ? "" : ",")
}
@:] as const satisfies readonly number[];
@:
@:export const @schemaName = z.union([
@foreach (var enumValue in enumValues)
{
    @:  z.literal(@Raw(enumValue))@(enumValue == enumValues.Last() ? "" : ",")
}
@:]);
}

