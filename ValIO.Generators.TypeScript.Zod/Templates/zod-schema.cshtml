@using ValIO.Generators.TypeScript.Models
@using ValIO.Generators.TypeScript.Zod.Models
@model ZodSchemaTemplateData
@{
    var schemaName = Model.SchemaName;
    var typeName = Model.TypeName;
    var properties = Model.Properties;
    var description = Model.Description;
}
@if (!string.IsNullOrEmpty(description))
{
@:/**
@: * @Raw(description)
@: */
}
import { z } from 'zod';
@if (Model.SchemaDependencies != null && Model.SchemaDependencies.Count > 0)
{
@foreach (var dep in Model.SchemaDependencies)
{
    var depFileName = Model.SchemaNameToFileName(dep);
@:import { @dep } from './@(depFileName).schema';
}
}
@if (Model.EnumDependencies != null && Model.EnumDependencies.Count > 0)
{
@foreach (var dep in Model.EnumDependencies)
{
    var depFileName = Model.SchemaNameToFileName(dep);
@:import { @dep } from './@(depFileName).schema';
}
}

@if (Model.HasCircularReference)
{
@:// TypeScript интерфейс для строгой типизации рекурсивной схемы
@:type @(typeName) = {
@foreach (var property in properties)
{
    @if (!string.IsNullOrEmpty(property.Description))
    {
    @:  /**
    @:   * @Raw(property.Description)
    @:   */
    }
    @if (!string.IsNullOrEmpty(property.TypeScriptType))
    {
        var tsType = property.TypeScriptType;
        // Для циклических ссылок используем TypeName напрямую
        if (property.ZodSchema.Contains($"z.lazy(() => {schemaName}"))
        {
            tsType = typeName;
        }
    @:  @property.Name@(property.IsRequired ? "" : "?") : @Raw(tsType);
    }
    else
    {
    @:  @property.Name@(property.IsRequired ? "" : "?") : any;
    }
}
@:};

@:export const @schemaName: z.ZodType<@typeName> = z.object({
@foreach (var property in properties)
{
    @if (!string.IsNullOrEmpty(property.Description))
    {
    @:  /**
    @:   * @Raw(property.Description)
    @:   */
    }
    @:  @property.Name: @Raw(property.ZodSchema)@(property.IsRequired ? "" : ".optional()"),
}
@:});
}
else
{
@:export const @schemaName = z.object({
@foreach (var property in properties)
{
    @if (!string.IsNullOrEmpty(property.Description))
    {
    @:  /**
    @:   * @Raw(property.Description)
    @:   */
    }
    @:  @property.Name: @Raw(property.ZodSchema)@(property.IsRequired ? "" : ".optional()"),
}
@:});
}

