<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ValIO.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ValIO.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <StackPanel Margin="16" Spacing="10">
    <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Text="Language" FontWeight="SemiBold" />
    <ComboBox ItemsSource="{Binding SupportedCultures}"
              SelectedItem="{Binding SelectedCulture}"
              DisplayMemberBinding="{Binding NativeName}"
              Width="240" HorizontalAlignment="Left" />
    <TextBlock Text="Change takes effect on next bound refresh." Foreground="{DynamicResource SystemBaseMediumColor}" />
  </StackPanel>
</UserControl>
