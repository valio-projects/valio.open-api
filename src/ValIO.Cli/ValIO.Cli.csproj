<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <PreserveCompilationContext>true</PreserveCompilationContext>
        <AssemblyName>valio</AssemblyName>
        <RootNamespace>ValIO.Cli</RootNamespace>
    </PropertyGroup>

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>valio</ToolCommandName>
        <PackageId>ValIO.Cli</PackageId>
        <Description>OpenAPI 3.x to type-safe HTTP clients, models and validation schemas for TypeScript, C#, Java, Kotlin, Python, PHP, C++, Swift, Rust, Ruby, F#, Dart. CLI for the ValIO code generator.</Description>
        <PackageTags>openapi;swagger;codegen;cli;dotnet-tool;typescript;csharp</PackageTags>
        <!-- Tool packages don't support separate symbol packages -->
        <IncludeSymbols>false</IncludeSymbols>
        <SymbolPackageFormat></SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
      <PackageReference Include="Microsoft.Extensions.Logging" />
      <PackageReference Include="Microsoft.Extensions.Logging.Console" />
      <PackageReference Include="System.CommandLine" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ValIO.Application\ValIO.Application.csproj" />
      <ProjectReference Include="..\ValIO.Output\ValIO.Output.csproj" />
      <ProjectReference Include="..\ValIO.Localization\ValIO.Localization.csproj" />
      <ProjectReference Include="..\ValIO.Plugins.Bootstrap\ValIO.Plugins.Bootstrap.csproj" />
      <ProjectReference Include="..\ValIO.Parsers\ValIO.Parsers.csproj" />
      <ProjectReference Include="..\ValIO.Configuration\ValIO.Configuration.csproj" />
      <ProjectReference Include="..\ValIO.Core\ValIO.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\..\valio.config.json">
        <Link>valio.config.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="..\..\valio.config.typescript.example.json">
        <Link>valio.config.typescript.example.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

</Project>
