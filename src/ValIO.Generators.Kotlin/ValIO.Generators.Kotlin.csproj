<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PreserveCompilationContext>true</PreserveCompilationContext>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>ValIO.Generators.Kotlin</PackageId>
    <Description>ValIO code generator plugin for Kotlin.</Description>
    <PackageTags>valio;openapi;codegen;kotlin</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ValIO.Core\ValIO.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.OpenApi" />
  </ItemGroup>

</Project>
