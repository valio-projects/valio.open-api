<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <PreserveCompilationContext>true</PreserveCompilationContext>
        <AssemblyName>valio</AssemblyName>
        <RootNamespace>ValIO</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
      <PackageReference Include="Microsoft.Extensions.Logging" />
      <PackageReference Include="Microsoft.Extensions.Logging.Console" />
      <PackageReference Include="System.CommandLine" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ValIO.Application\ValIO.Application.csproj" />
      <ProjectReference Include="..\ValIO.Output\ValIO.Output.csproj" />
      <ProjectReference Include="..\ValIO.Localization\ValIO.Localization.csproj" />
      <ProjectReference Include="..\ValIO.Plugins.Bootstrap\ValIO.Plugins.Bootstrap.csproj" />
      <ProjectReference Include="..\ValIO.Parsers\ValIO.Parsers.csproj" />
      <ProjectReference Include="..\ValIO.Configuration\ValIO.Configuration.csproj" />
      <ProjectReference Include="..\ValIO.Core\ValIO.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\..\valio.config.json">
        <Link>valio.config.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="..\..\valio.config.typescript.example.json">
        <Link>valio.config.typescript.example.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

</Project>
