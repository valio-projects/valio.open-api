<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <PreserveCompilationContext>true</PreserveCompilationContext>
        <AssemblyName>valio</AssemblyName>
        <RootNamespace>ValIO</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Logging" />
      <PackageReference Include="Microsoft.Extensions.Logging.Console" />
      <PackageReference Include="Microsoft.OpenApi" />
      <PackageReference Include="System.CommandLine" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ValIO.Core\ValIO.Core.csproj" />
      <ProjectReference Include="..\ValIO.Parsers\ValIO.Parsers.csproj" />
      <ProjectReference Include="..\ValIO.Configuration\ValIO.Configuration.csproj" />
      <ProjectReference Include="..\ValIO.Generators.CSharp\ValIO.Generators.CSharp.csproj" />
      <ProjectReference Include="..\ValIO.Generators.TypeScript\ValIO.Generators.TypeScript.csproj" />
      <ProjectReference Include="..\ValIO.Generators.Cpp\ValIO.Generators.Cpp.csproj" />
      <ProjectReference Include="..\ValIO.Generators.Php\ValIO.Generators.Php.csproj" />
      <ProjectReference Include="..\ValIO.Generators.Python\ValIO.Generators.Python.csproj" />
      <ProjectReference Include="..\ValIO.Generators.Java\ValIO.Generators.Java.csproj" />
      <ProjectReference Include="..\ValIO.Generators.Kotlin\ValIO.Generators.Kotlin.csproj" />
      <ProjectReference Include="..\ValIO.Generators.Swift\ValIO.Generators.Swift.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\..\valio.config.json">
        <Link>valio.config.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="..\..\valio.config.typescript.example.json">
        <Link>valio.config.typescript.example.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

</Project>
