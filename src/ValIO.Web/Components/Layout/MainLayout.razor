@inherits LayoutComponentBase
@inject ThemeService Theme
@inject IJSRuntime JS

<MudThemeProvider IsDarkMode="@Theme.IsDark" Theme="@_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIcon Icon="@Icons.Material.Filled.Bolt" Class="mr-2" />
        <MudText Typo="Typo.h6">ValIO</MudText>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Inherit" Class="ml-2">OpenAPI codegen</MudChip>
        <MudSpacer />
        <MudButton Href="/" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Home">Home</MudButton>
        <MudButton Href="/generate" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.RocketLaunch">Generate</MudButton>
        <MudButton Href="/validate" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.RuleFolder">Validate</MudButton>
        <MudButton Href="/about" Color="Color.Inherit">About</MudButton>
        <MudTooltip Text="@(Theme.IsDark ? "Light mode" : "Dark mode")">
            <MudIconButton Color="Color.Inherit"
                           Icon="@(Theme.IsDark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           OnClick="ToggleThemeAsync" />
        </MudTooltip>
        <LanguageSwitcher />
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 mb-12">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#5b6cf7",
            Secondary = "#9c27b0",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#7e8cff",
            Secondary = "#bb86fc",
            Background = "#121826",
            Surface = "#1a2333",
            AppbarBackground = "#0f1622",
            DrawerBackground = "#0f1622",
        }
    };

    private bool _hydrated;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _hydrated) return;
        _hydrated = true;
        try
        {
            var saved = await JS.InvokeAsync<string?>("valioTheme.get");
            if (string.Equals(saved, "dark", StringComparison.OrdinalIgnoreCase))
            {
                Theme.IsDark = true;
                StateHasChanged();
            }
        }
        catch { /* not interactive yet */ }
    }

    private async Task ToggleThemeAsync()
    {
        Theme.IsDark = !Theme.IsDark;
        try { await JS.InvokeVoidAsync("valioTheme.set", Theme.IsDark ? "dark" : "light"); }
        catch { /* ignore */ }
    }
}
