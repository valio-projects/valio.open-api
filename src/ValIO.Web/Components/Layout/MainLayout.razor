@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6" Class="ml-4">ValIO</MudText>
        <MudSpacer />
        <MudButton Href="/" Color="Color.Inherit">Home</MudButton>
        <MudButton Href="/generate" Color="Color.Inherit">Generate</MudButton>
        <MudButton Href="/about" Color="Color.Inherit">About</MudButton>
        <LanguageSwitcher />
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
