@* Reusable framed section used by the Generate page. *@

<MudPaper Elevation="0" Outlined="true" Class="@($"pa-6 valio-section {ExtraClass}")" Style="height: 100%">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-3">
        <MudAvatar Color="@(IsValid ? Color.Success : Color.Default)"
                   Variant="Variant.Filled" Size="Size.Medium">
            @if (IsValid)
            {
                <MudIcon Icon="@Icons.Material.Filled.Check" />
            }
            else
            {
                <span>@Number</span>
            }
        </MudAvatar>
        <MudStack Spacing="0">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                @if (!string.IsNullOrEmpty(Icon))
                {
                    <MudIcon Icon="@Icon" Size="Size.Small" Color="Color.Default" />
                }
                <MudText Typo="Typo.h6" Class="mb-0">@Title</MudText>
            </MudStack>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <MudText Typo="Typo.body2" Color="Color.Default">@Subtitle</MudText>
            }
        </MudStack>
    </MudStack>
    @ChildContent
</MudPaper>

@code {
    [Parameter] public int Number { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public bool IsValid { get; set; }
    [Parameter] public string? ExtraClass { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
