@page "/"

<PageTitle>ValIO — OpenAPI Code Generator</PageTitle>

<MudPaper Elevation="0" Class="pa-8 d-flex flex-column align-center text-center">
    <MudText Typo="Typo.h2" GutterBottom="true">ValIO</MudText>
    <MudText Typo="Typo.h6" Class="mb-6" Style="max-width:560px">
        Generate type-safe HTTP clients, models, and validation schemas
        for TypeScript, C#, Java, Kotlin, Python, PHP, Swift, and Unreal-flavored C++
        from OpenAPI 3.x.
    </MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Href="/generate">
        Generate code
    </MudButton>
</MudPaper>

<MudGrid Class="mt-8">
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-6" Elevation="1">
            <MudText Typo="Typo.h6" GutterBottom="true">CLI</MudText>
            <MudText>One command from OpenAPI to clients. Configurable per language.</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-6" Elevation="1">
            <MudText Typo="Typo.h6" GutterBottom="true">Web UI</MudText>
            <MudText>Browser-based playground — upload a schema, get a zip.</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-6" Elevation="1">
            <MudText Typo="Typo.h6" GutterBottom="true">Desktop</MudText>
            <MudText>Native Avalonia app for offline use.</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>
