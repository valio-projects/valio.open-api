@page "/generate"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using ValIO.Core.Plugins
@inject GenerationFormState State
@inject IGeneratorRegistry Registry
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Generate — ValIO</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Generate code</MudText>
<MudText Class="mb-6" Typo="Typo.body1">
    Pick an OpenAPI schema, choose a target language, tweak the options, get a zip.
</MudText>

<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-6" Elevation="1">
            <MudText Typo="Typo.h6" GutterBottom="true">Schema</MudText>

            <MudTabs Elevation="0" Rounded="true" ActivePanelIndexChanged="OnTabChanged">
                <MudTabPanel Text="URL">
                    <MudTextField @bind-Value="State.SchemaUrl"
                                  Label="OpenAPI schema URL"
                                  Placeholder="https://petstore3.swagger.io/api/v3/openapi.json"
                                  Variant="Variant.Outlined" />
                </MudTabPanel>
                <MudTabPanel Text="Upload">
                    <MudFileUpload T="IBrowserFile" FilesChanged="OnFileChanged" Accept=".json,.yaml,.yml">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Upload">
                                Choose file
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                    @if (!string.IsNullOrEmpty(State.UploadedSchemaName))
                    {
                        <MudText Typo="Typo.caption" Class="mt-2">
                            Selected: @State.UploadedSchemaName (@(State.UploadedSchemaBytes?.Length ?? 0) bytes)
                        </MudText>
                    }
                </MudTabPanel>
            </MudTabs>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-6" Elevation="1">
            <MudText Typo="Typo.h6" GutterBottom="true">Language</MudText>
            <MudSelect T="string" @bind-Value="State.LanguageId"
                       Label="Target language"
                       Variant="Variant.Outlined">
                @foreach (var p in Registry.AllPlugins)
                {
                    <MudSelectItem T="string" Value="@p.LanguageId">@p.DisplayName</MudSelectItem>
                }
            </MudSelect>

            @if (CurrentPlugin is { } plugin)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-4">Plugin: @plugin.DisplayName</MudText>
                <DynamicPluginOptions Plugin="plugin" State="State" />
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-6" Elevation="1">
            <MudText Typo="Typo.h6" GutterBottom="true">Output structure</MudText>
            <MudCheckBox T="bool" @bind-Value="State.GenerateModels" Label="Generate models" />
            <MudCheckBox T="bool" @bind-Value="State.GenerateClients" Label="Generate clients" />
            <MudCheckBox T="bool" @bind-Value="State.GenerateEnums" Label="Generate enums" />
            <MudTextField @bind-Value="State.NamespaceName"
                          Label="Namespace / package (optional)"
                          Variant="Variant.Outlined" Class="mt-2" />
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-6" Elevation="1">
            <MudText Typo="Typo.h6" GutterBottom="true">Result</MudText>
            <MudText>Result is delivered as a downloadable ZIP archive.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Size="Size.Large"
                       Disabled="@(!State.IsReady || _busy)"
                       OnClick="GenerateAsync"
                       Class="mt-4">
                @if (_busy)
                {
                    <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                    <span>Generating...</span>
                }
                else
                {
                    <span>Generate &amp; download</span>
                }
            </MudButton>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private bool _busy;

    private IGeneratorPlugin? CurrentPlugin =>
        string.IsNullOrEmpty(State.LanguageId) ? null : Registry.FindPlugin(State.LanguageId);

    private void OnTabChanged(int index)
    {
        State.SchemaKind = index == 0 ? SchemaSourceKind.Url : SchemaSourceKind.Upload;
    }

    private async Task OnFileChanged(IBrowserFile file)
    {
        State.SchemaKind = SchemaSourceKind.Upload;
        using var ms = new MemoryStream();
        await using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
        await stream.CopyToAsync(ms);
        State.UploadedSchemaBytes = ms.ToArray();
        State.UploadedSchemaName = file.Name;
    }

    private async Task GenerateAsync()
    {
        _busy = true;
        try
        {
            var payload = new
            {
                schemaUrl = State.SchemaKind == SchemaSourceKind.Url ? State.SchemaUrl : null,
                schemaFileName = State.SchemaKind == SchemaSourceKind.Upload ? State.UploadedSchemaName : null,
                schemaContentBase64 = State.SchemaKind == SchemaSourceKind.Upload && State.UploadedSchemaBytes is not null
                    ? Convert.ToBase64String(State.UploadedSchemaBytes)
                    : null,
                languageId = State.LanguageId,
                @namespace = State.NamespaceName,
                generateModels = State.GenerateModels,
                generateClients = State.GenerateClients,
                generateEnums = State.GenerateEnums,
                pluginOptions = State.PluginOptions
            };

            await JS.InvokeVoidAsync("valioDownload", "/api/generate", payload);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Generation failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
