@page "/generate"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using ValIO.Core.Plugins
@inject GenerationFormState State
@inject IGeneratorRegistry Registry
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Generate — ValIO</PageTitle>

<MudStack Spacing="0" Class="mb-6">
    <MudText Typo="Typo.h3" Class="mb-1">Generate code</MudText>
    <MudText Typo="Typo.body1" Color="Color.Default">
        OpenAPI schema in, type-safe clients out — pick the target stack and grab the result as a zip.
    </MudText>
</MudStack>

<MudGrid>

    <!-- ============================== STEP 1. Schema ============================== -->
    <MudItem xs="12" md="6">
        <SectionCard Number="1"
                     Title="Schema"
                     Subtitle="JSON or YAML. Public URL or local upload."
                     Icon="@Icons.Material.Filled.UploadFile"
                     IsValid="@State.HasSchema">
            <MudTabs Elevation="0" Rounded="true" Border="false"
                     ActivePanelIndex="@((int)State.SchemaKind)"
                     ActivePanelIndexChanged="OnTabChanged">
                <MudTabPanel Text="URL" Icon="@Icons.Material.Filled.Link">
                    <MudTextField @bind-Value="State.SchemaUrl"
                                  Label="OpenAPI schema URL"
                                  Placeholder="https://petstore3.swagger.io/api/v3/openapi.json"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Public"
                                  Class="mt-2" />
                </MudTabPanel>
                <MudTabPanel Text="Upload" Icon="@Icons.Material.Filled.CloudUpload">
                    <MudStack Class="mt-2" Spacing="2">
                        <MudFileUpload T="IBrowserFile" FilesChanged="OnFileChanged"
                                       Accept=".json,.yaml,.yml" MaximumFileCount="1">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.AttachFile">
                                    Choose .json or .yaml file
                                </MudButton>
                            </ActivatorContent>
                        </MudFileUpload>
                        @if (!string.IsNullOrEmpty(State.UploadedSchemaName))
                        {
                            <MudChip T="string" Color="Color.Success"
                                     Icon="@Icons.Material.Filled.CheckCircle"
                                     OnClose="ClearUpload">
                                @State.UploadedSchemaName · @FormatBytes(State.UploadedSchemaBytes?.Length ?? 0)
                            </MudChip>
                        }
                        <MudText Typo="Typo.caption" Color="Color.Default">
                            Maximum 10 MB. Schema never leaves the server — it's parsed in memory.
                        </MudText>
                    </MudStack>
                </MudTabPanel>
            </MudTabs>
        </SectionCard>
    </MudItem>

    <!-- ============================== STEP 2. Language ============================== -->
    <MudItem xs="12" md="6">
        <SectionCard Number="2"
                     Title="Target language"
                     Subtitle="Pick a generator plugin."
                     Icon="@Icons.Material.Filled.Code"
                     IsValid="@(CurrentPlugin is not null)">
            <MudSelect T="string" Value="@State.LanguageId"
                       ValueChanged="OnLanguageChanged"
                       Label="Language"
                       Variant="Variant.Outlined"
                       Class="mt-2"
                       Dense="true">
                @foreach (var p in Registry.AllPlugins)
                {
                    <MudSelectItem T="string" Value="@p.LanguageId">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@LanguageIcon(p.LanguageId)" Size="Size.Small" />
                            <span>@p.DisplayName</span>
                            <MudSpacer />
                            <MudText Typo="Typo.caption" Color="Color.Default">@p.LanguageId</MudText>
                        </MudStack>
                    </MudSelectItem>
                }
            </MudSelect>
            @if (CurrentPlugin is { } plugin && plugin.LanguageAliases.Count > 0)
            {
                <MudText Typo="Typo.caption" Class="mt-2">
                    Aliases: @string.Join(", ", plugin.LanguageAliases)
                </MudText>
            }
        </SectionCard>
    </MudItem>

    <!-- ============================== STEP 3. Plugin options ============================== -->
    <MudItem xs="12">
        <SectionCard Number="3"
                     Title="Plugin options"
                     Subtitle="Configure how the generator emits code. Options with dependencies appear as you fill prerequisites."
                     Icon="@Icons.Material.Filled.Tune"
                     IsValid="@(CurrentPlugin is not null)">
            @if (CurrentPlugin is null)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-2">
                    Pick a target language first.
                </MudAlert>
            }
            else
            {
                <DynamicPluginOptions Plugin="CurrentPlugin" State="State" />
            }
        </SectionCard>
    </MudItem>

    <!-- ============================== STEP 4. Output structure ============================== -->
    <MudItem xs="12" md="6">
        <SectionCard Number="4"
                     Title="What to generate"
                     Subtitle="Toggle output categories and set a namespace/package."
                     Icon="@Icons.Material.Filled.Layers"
                     IsValid="true">
            <MudStack Class="mt-2" Spacing="0">
                <MudSwitch T="bool" @bind-Value="State.GenerateModels" Color="Color.Primary" Label="Models / DTOs" />
                <MudSwitch T="bool" @bind-Value="State.GenerateClients" Color="Color.Primary" Label="HTTP clients" />
                <MudSwitch T="bool" @bind-Value="State.GenerateEnums" Color="Color.Primary" Label="Enums" />
            </MudStack>
            <MudTextField @bind-Value="State.NamespaceName"
                          Label="Namespace / package"
                          HelperText="Used by C#, Java, Kotlin, PHP. Ignored where not applicable."
                          Variant="Variant.Outlined"
                          Class="mt-4" />
        </SectionCard>
    </MudItem>

    <!-- ============================== STEP 5. Result ============================== -->
    <MudItem xs="12" md="6">
        <SectionCard Number="5"
                     Title="Result"
                     Subtitle="Download the generated tree as a zip."
                     Icon="@Icons.Material.Filled.Download"
                     IsValid="State.IsReady">

            @if (State.IsReady)
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mt-2">
                    Ready to generate <strong>@CurrentPlugin?.DisplayName</strong>.
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-2">
                    @MissingFieldsMessage()
                </MudAlert>
            }

            <MudStack Row="true" Class="mt-4" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           Size="Size.Large" FullWidth="true"
                           StartIcon="@Icons.Material.Filled.RocketLaunch"
                           Disabled="@(!State.IsReady || _busy)"
                           OnClick="GenerateAsync">
                    @if (_busy)
                    {
                        <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                        <span>Generating &amp; packaging...</span>
                    }
                    else
                    {
                        <span>Generate &amp; download zip</span>
                    }
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="OnReset"
                           Disabled="@_busy">
                    Reset
                </MudButton>
            </MudStack>
        </SectionCard>
    </MudItem>
</MudGrid>

@code {
    private bool _busy;

    private IGeneratorPlugin? CurrentPlugin =>
        string.IsNullOrEmpty(State.LanguageId) ? null : Registry.FindPlugin(State.LanguageId);

    private void OnTabChanged(int index)
    {
        State.SchemaKind = index == 0 ? SchemaSourceKind.Url : SchemaSourceKind.Upload;
    }

    private void OnLanguageChanged(string? newId)
    {
        State.LanguageId = newId;
        StateHasChanged();
    }

    private async Task OnFileChanged(IBrowserFile file)
    {
        State.SchemaKind = SchemaSourceKind.Upload;
        using var ms = new MemoryStream();
        await using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
        await stream.CopyToAsync(ms);
        State.UploadedSchemaBytes = ms.ToArray();
        State.UploadedSchemaName = file.Name;
    }

    private void ClearUpload(MudChip<string> _)
    {
        State.UploadedSchemaBytes = null;
        State.UploadedSchemaName = null;
    }

    private void OnReset()
    {
        State.SchemaUrl = null;
        State.UploadedSchemaBytes = null;
        State.UploadedSchemaName = null;
        State.NamespaceName = null;
        State.LanguageId = null;
        State.GenerateModels = true;
        State.GenerateClients = true;
        State.GenerateEnums = true;
        State.ResetPluginOptions();
        Snackbar.Add("Form reset", Severity.Info);
    }

    private string MissingFieldsMessage()
    {
        var missing = new List<string>();
        if (!State.HasSchema) missing.Add("schema");
        if (string.IsNullOrWhiteSpace(State.LanguageId)) missing.Add("target language");
        return missing.Count == 0
            ? "Almost ready."
            : "Still missing: " + string.Join(", ", missing) + ".";
    }

    private async Task GenerateAsync()
    {
        _busy = true;
        StateHasChanged();
        try
        {
            var payload = new
            {
                schemaUrl = State.SchemaKind == SchemaSourceKind.Url ? State.SchemaUrl : null,
                schemaFileName = State.SchemaKind == SchemaSourceKind.Upload ? State.UploadedSchemaName : null,
                schemaContentBase64 = State.SchemaKind == SchemaSourceKind.Upload && State.UploadedSchemaBytes is not null
                    ? Convert.ToBase64String(State.UploadedSchemaBytes)
                    : null,
                languageId = State.LanguageId,
                @namespace = State.NamespaceName,
                generateModels = State.GenerateModels,
                generateClients = State.GenerateClients,
                generateEnums = State.GenerateEnums,
                pluginOptions = State.PluginOptions
            };

            await JS.InvokeVoidAsync("valioDownload", "/api/generate", payload);
            Snackbar.Add("Zip downloaded.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Generation failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private static string LanguageIcon(string id) => id switch
    {
        "typescript" => Icons.Material.Filled.Code,
        "csharp"     => Icons.Material.Filled.Tag,
        "java"       => Icons.Material.Filled.Coffee,
        "kotlin"     => Icons.Material.Filled.Bolt,
        "python"     => Icons.Material.Filled.Pets,
        "php"        => Icons.Material.Filled.Web,
        "swift"      => Icons.Material.Filled.FlightTakeoff,
        "cpp"        => Icons.Material.Filled.Memory,
        _            => Icons.Material.Filled.Terminal,
    };

    private static string FormatBytes(int bytes)
    {
        if (bytes < 1024) return bytes + " B";
        if (bytes < 1024 * 1024) return (bytes / 1024.0).ToString("F1") + " KB";
        return (bytes / 1024.0 / 1024.0).ToString("F1") + " MB";
    }
}
