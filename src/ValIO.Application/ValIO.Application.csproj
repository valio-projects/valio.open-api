<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>ValIO.Application</PackageId>
    <Description>ValIO orchestration engine. Use to embed code generation in your host application.</Description>
    <PackageTags>valio;openapi;codegen;orchestration</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ValIO.Core\ValIO.Core.csproj" />
    <ProjectReference Include="..\ValIO.Parsers\ValIO.Parsers.csproj" />
    <ProjectReference Include="..\ValIO.Configuration\ValIO.Configuration.csproj" />
    <ProjectReference Include="..\ValIO.Output\ValIO.Output.csproj" />
    <ProjectReference Include="..\ValIO.Localization\ValIO.Localization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

</Project>
