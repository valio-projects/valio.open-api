<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PreserveCompilationContext>true</PreserveCompilationContext>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>ValIO.Generators.Java</PackageId>
    <Description>ValIO code generator plugin for Java.</Description>
    <PackageTags>valio;openapi;codegen;java</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ValIO.Core\ValIO.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/build.gradle.kts" LogicalName="ValIO.Resources.build.gradle.kts" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/gradle.properties" LogicalName="ValIO.Resources.gradle.properties" />
  </ItemGroup>

</Project>
