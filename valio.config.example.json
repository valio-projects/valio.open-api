{
  "projects": {
    "MyNativeApi": {
      "language": "cpp",
      "schema": "https://api.example.com/swagger/v1/swagger.json",
      "outputPath": "C:\\Workspace\\MyProject\\Generated",
      "generateModels": true,
      "generateClients": true,
      "options": {
        "runtime": "std",
        "cxxStandard": 17,
        "apiStyle": "both",
        "clientShape": "interface+impl",
        "namespace": "MyNativeApi"
      }
    },
    "MyApi": {
      "language": "CSharp",
      "schema": "https://api.example.com/swagger/v1/swagger.json",
      "outputPath": "C:\\Workspace\\MyProject\\Generated",
      "namespace": "MyProject.Generated",
      "generateModels": true,
      "generateClients": true,
      "options": {
        "csharp": {
          "propertyAccessor": "Init",
          "useRequired": true,
          "useSealed": true,
          "modelType": "Class",
          "generateEqualityMembers": true,
          "useNullable": true,
          "generateValidationConstants": true,
          "generateValidationAttributes": true,
          "queryParametersStyle": "ModelClass",
          "enableOpenTelemetry": true,
          "generateTraces": true,
          "generateMetrics": true
        }
      },
      "fileOrganization": {
        "groupingStrategy": "SingleFile",
        "separateModels": true,
        "separateClients": true,
        "modelsPath": null,
        "clientsPath": null
      },
      "namingConvention": {
        "models": "PascalCase",
        "properties": "PascalCase",
        "methods": "PascalCase",
        "enums": "PascalCase"
      }
    }
  }
}
