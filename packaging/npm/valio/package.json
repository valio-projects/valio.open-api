{
  "name": "@valio-projects/valio",
  "version": "0.1.0",
  "description": "OpenAPI to type-safe HTTP clients for 12 languages — CLI wrapper.",
  "bin": {
    "valio": "./dist/valio.js"
  },
  "main": "./dist/valio.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build",
    "postinstall": "node ./dist/install.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "optionalDependencies": {
    "@valio-projects/cli-win32-x64": "0.1.0",
    "@valio-projects/cli-linux-x64": "0.1.0",
    "@valio-projects/cli-linux-arm64": "0.1.0",
    "@valio-projects/cli-darwin-x64": "0.1.0",
    "@valio-projects/cli-darwin-arm64": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^26.5.0"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "license": "LGPL-2.1-only",
  "homepage": "https://valio.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valio-projects/valio.open-api.git",
    "directory": "packaging/npm/valio"
  },
  "keywords": [
    "openapi",
    "swagger",
    "codegen",
    "typescript",
    "csharp",
    "rest",
    "client"
  ]
}
