namespace {{ namespace }};

{{~ if description && description != "" ~}}
/// <summary>
/// {{ description }}
/// </summary>
{{~ end ~}}
public enum {{ enum_name }} : {{ underlying_type }}
{
{{~ for value in values ~}}
    {{~ if value.description && value.description != "" ~}}
    /// <summary>
    /// {{ value.description }}
    /// </summary>
    {{~ end ~}}
    {{ value.name }} = {{ value.value_string }}{{ if !for.last }},{{ end }}
{{~ end ~}}
}
