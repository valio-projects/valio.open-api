@using ValIO.Generators.CSharp.Models
@using ValIO.Generators.CSharp.Helpers
@model ModelTemplateData
@functions {
    string FormatDefaultValue(object? value, TypeInfo typeInfo)
    {
        if (value == null)
            return "null";
        
        var baseType = typeInfo.BaseType;
        var isNullable = typeInfo.IsNullable;
        
        if (baseType == "string")
        {
            return $"\"{value}\"";
        }
        
        if (baseType == "bool")
        {
            return value.ToString()?.ToLowerInvariant() ?? "false";
        }
        
        if (baseType == "float")
        {
            return $"{value}f";
        }
        
        if (baseType == "double")
        {
            return value.ToString() ?? "0.0";
        }
        
        return value.ToString() ?? "0";
    }
    
    string FormatType(TypeInfo typeInfo)
    {
        return typeInfo.FullTypeName;
    }
}
@{
    var namespaceName = Model.Namespace;
    var className = Model.ClassName;
    var description = Model.Description;
    var properties = Model.Properties;
    var modelType = Model.ModelType;
    var isSealed = Model.IsSealed;
    var generateEqualityMembers = Model.GenerateEqualityMembers;
    var generateValidationConstants = Model.GenerateValidationConstants;
    var generateValidationAttributes = Model.GenerateValidationAttributes;
    
    // Определяем ключевое слово типа модели
    string typeKeyword = modelType switch
    {
        ModelType.Record => "record",
        ModelType.Struct => "struct",
        ModelType.RecordStruct => "record struct",
        _ => "class"
    };
    
    // Определяем модификатор sealed
    string sealedModifier = isSealed && modelType == ModelType.Class ? "sealed " : string.Empty;
    
    // Для record синтаксис отличается - используем primary constructor
    bool isRecord = modelType == ModelType.Record || modelType == ModelType.RecordStruct;
}
@if (Model.NeedsDataAnnotations)
{
@:using System.ComponentModel.DataAnnotations;
}
@if (Model.NeedsRegularExpressions)
{
@:using System.Text.RegularExpressions;
}
namespace @(namespaceName);

@if (!string.IsNullOrEmpty(description))
{
@:/// <summary>
@:/// @Raw(description)
@:/// </summary>
}
@if (isRecord)
{
    var baseClassDeclaration = !string.IsNullOrEmpty(Model.BaseClassName) ? $" : {Model.BaseClassName}" : string.Empty;
@:@(sealedModifier)public @typeKeyword @(className)@baseClassDeclaration
@:{
@if (generateValidationConstants)
{
@foreach (var property in properties)
{
    var hasConstants = property.DefaultValue != null || property.Min.HasValue || property.Max.HasValue || 
                       property.ExclusiveMin.HasValue || property.ExclusiveMax.HasValue ||
                       property.MinLength.HasValue || property.MaxLength.HasValue || 
                       !string.IsNullOrEmpty(property.Pattern);
    if (hasConstants)
    {
    @:/// <summary>
    @:/// Константы валидации для свойства @(property.Name)
    @:/// </summary>
    @:    public static class @(property.Name)Constants
    @:    {
        @if (property.MinLength.HasValue)
        {
    @:        public const int MinLength = @(property.MinLength.Value);
        }
        @if (property.MaxLength.HasValue)
        {
    @:        public const int MaxLength = @(property.MaxLength.Value);
        }
        @if (property.Min.HasValue)
        {
    @:        public const decimal Min = @(property.Min.Value);
        }
        @if (property.Max.HasValue)
        {
    @:        public const decimal Max = @(property.Max.Value);
        }
        @if (property.ExclusiveMin.HasValue)
        {
    @:        public const decimal ExclusiveMin = @(property.ExclusiveMin.Value);
        }
        @if (property.ExclusiveMax.HasValue)
        {
    @:        public const decimal ExclusiveMax = @(property.ExclusiveMax.Value);
        }
        @if (!string.IsNullOrEmpty(property.Pattern))
        {
            var escapedPattern = property.Pattern.Replace("\\", "\\\\").Replace("\"", "\\\"");
    @:        public const string Pattern = "@Raw(escapedPattern)";
    @:
    @:        public static readonly Regex PatternRegex = new Regex(Pattern, RegexOptions.Compiled);
        }
        @if (property.DefaultValue != null)
        {
            var defaultValueString = FormatDefaultValue(property.DefaultValue, property.TypeInfo);
            var typeString = FormatType(property.TypeInfo);
    @:        public const @typeString DefaultValue = @defaultValueString;
        }
    @:    }
    @:
    }
}
}
@foreach (var property in properties)
{
    @if (!string.IsNullOrEmpty(property.Description))
    {
    @:/// <summary>
    @:/// @Raw(property.Description)
    @:/// </summary>
    }
    @if (generateValidationAttributes)
    {
        var propertyHasConstants = generateValidationConstants && (property.DefaultValue != null || property.Min.HasValue || property.Max.HasValue || 
                       property.ExclusiveMin.HasValue || property.ExclusiveMax.HasValue ||
                       property.MinLength.HasValue || property.MaxLength.HasValue || 
                       !string.IsNullOrEmpty(property.Pattern));
        // Генерируем атрибуты валидации
        @if (property.IsRequired)
        {
    @:    [Required]
        }
        @if (propertyHasConstants)
        {
            // Используем константы из класса
            @if (property.MinLength.HasValue && property.MaxLength.HasValue)
            {
    @:    [StringLength(@(property.Name)Constants.MaxLength, MinimumLength = @(property.Name)Constants.MinLength)]
            }
            else
            {
                @if (property.MinLength.HasValue)
                {
    @:    [MinLength(@(property.Name)Constants.MinLength)]
                }
                @if (property.MaxLength.HasValue)
                {
    @:    [MaxLength(@(property.Name)Constants.MaxLength)]
                }
            }
            @if (property.Min.HasValue && property.Max.HasValue)
            {
    @:    [Range(@(property.Name)Constants.Min, @(property.Name)Constants.Max)]
            }
            else
            {
                @if (property.Min.HasValue)
                {
    @:    [Range(@(property.Name)Constants.Min, double.MaxValue)]
                }
                @if (property.Max.HasValue)
                {
    @:    [Range(double.MinValue, @(property.Name)Constants.Max)]
                }
            }
            @if (!string.IsNullOrEmpty(property.Pattern))
            {
    @:    [RegularExpression(@(property.Name)Constants.Pattern)]
            }
        }
        else
        {
            // Используем прямые значения
            @if (property.MinLength.HasValue && property.MaxLength.HasValue)
            {
    @:    [StringLength(@(property.MaxLength.Value), MinimumLength = @(property.MinLength.Value))]
            }
            else
            {
                @if (property.MinLength.HasValue)
                {
    @:    [MinLength(@(property.MinLength.Value))]
                }
                @if (property.MaxLength.HasValue)
                {
    @:    [MaxLength(@(property.MaxLength.Value))]
                }
            }
            @if (property.Min.HasValue && property.Max.HasValue)
            {
    @:    [Range(@(property.Min.Value), @(property.Max.Value))]
            }
            else
            {
                @if (property.Min.HasValue)
                {
    @:    [Range(@(property.Min.Value), double.MaxValue)]
                }
                @if (property.Max.HasValue)
                {
    @:    [Range(double.MinValue, @(property.Max.Value))]
                }
            }
            @if (!string.IsNullOrEmpty(property.Pattern))
            {
                var escapedPattern = property.Pattern.Replace("\\", "\\\\").Replace("\"", "\\\"");
    @:    [RegularExpression("@Raw(escapedPattern)")]
            }
        }
    }
    var requiredModifier = property.IsRequired ? "required " : string.Empty;
    // Используем TypeInfo для определения nullable - если тип уже nullable в TypeInfo, не добавляем "?"
    var typeString = FormatType(property.TypeInfo);
    var nullableModifier = property.IsNullable && !property.TypeInfo.IsNullable && !typeString.EndsWith("?") ? "?" : string.Empty;
    var accessorType = property.AccessorType == PropertyAccessorType.Init ? "init" : "set";
    @:public @requiredModifier@typeString@nullableModifier @property.Name { get; @accessorType; }
}
@:}
@if (!generateEqualityMembers)
