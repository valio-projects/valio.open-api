using System.Net.Http;
using System.Net.Http.Json;
using System.Threading.Tasks;
using System.Text;

namespace {{ namespace }};

/// <summary>
/// HTTP клиент для {{ client_name }}
/// </summary>
public class {{ class_name }}
{
    private readonly HttpClient _httpClient;

    public {{ class_name }}(HttpClient httpClient)
    {
        _httpClient = httpClient;
    }

{{~ for operation in operations ~}}
    {{~ if operation.summary && operation.summary != "" ~}}
    /// <summary>
    /// {{ operation.summary }}
    /// </summary>
    {{~ end ~}}
    public async {{ operation.return_type }} {{ operation.method_name }}({{ operation.parameters }})
    {
        {{~ if operation.has_path_parameters ~}}
        var path = "{{ operation.path }}";
        {{~ for param in operation.path_parameters ~}}
        path = path.Replace("{{ "{" }}{{ param.name }}{{ "}" }}", {{ param.variable_name }}.ToString());
        {{~ end ~}}
        var url = path;
        {{~ else ~}}
        var url = "{{ operation.path }}";
        {{~ end ~}}

        var request = new HttpRequestMessage(HttpMethod.{{ operation.http_method }}, url);
        
        {{~ if operation.has_query_parameters ~}}
        var queryParams = new List<string>();
        {{~ for param in operation.query_parameters ~}}
        {{~ if param.is_required ~}}
        if ({{ param.variable_name }} != null)
        {
            queryParams.Add($"{Uri.EscapeDataString("{{ param.name }}")}={Uri.EscapeDataString({{ param.variable_name }}.ToString())}");
        }
        {{~ else ~}}
        if ({{ param.variable_name }} != null)
        {
            queryParams.Add($"{Uri.EscapeDataString("{{ param.name }}")}={Uri.EscapeDataString({{ param.variable_name }}.ToString())}");
        }
        {{~ end ~}}
        {{~ end ~}}
        if (queryParams.Count > 0)
        {
            url += "?" + string.Join("&", queryParams);
            request.RequestUri = new Uri(url);
        }
        {{~ end ~}}

        {{~ if operation.has_header_parameters ~}}
        {{~ for param in operation.header_parameters ~}}
        {{~ if param.is_required ~}}
        request.Headers.Add("{{ param.name }}", {{ param.variable_name }}.ToString());
        {{~ else ~}}
        if ({{ param.variable_name }} != null)
        {
            request.Headers.Add("{{ param.name }}", {{ param.variable_name }}.ToString());
        }
        {{~ end ~}}
        {{~ end ~}}
        {{~ end ~}}

        {{~ if operation.has_request_body ~}}
        {{~ if operation.request_body_content_type == "application/json" ~}}
        request.Content = JsonContent.Create({{ operation.request_body_parameter }});
        {{~ else if operation.request_body_content_type == "application/x-www-form-urlencoded" ~}}
        var formContent = new FormUrlEncodedContent(new Dictionary<string, string>());
        request.Content = formContent;
        {{~ else if operation.request_body_content_type == "multipart/form-data" ~}}
        var multipartContent = new MultipartFormDataContent();
        request.Content = multipartContent;
        {{~ else ~}}
        request.Content = new StringContent({{ operation.request_body_parameter }}.ToString() ?? string.Empty);
        {{~ end ~}}
        {{~ end ~}}

        {{~ if operation.has_response_type ~}}
        var response = await _httpClient.SendAsync(request);
        response.EnsureSuccessStatusCode();
        {{~ if operation.return_type != "Task" && operation.return_type != "Task<HttpResponseMessage>" ~}}
        {{~ assign response_type = operation.return_type | string.replace "Task<" "" | string.replace ">" "" ~}}
        return await response.Content.ReadFromJsonAsync<{{ response_type }}>();
        {{~ else ~}}
        return response;
        {{~ end ~}}
        {{~ else ~}}
        return await _httpClient.SendAsync(request);
        {{~ end ~}}
    }

{{~ end ~}}
}
