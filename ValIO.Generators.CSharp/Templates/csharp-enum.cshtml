@using ValIO.Generators.CSharp.Models
@using ValIO.Generators.CSharp.Helpers
@model EnumTemplateData
@{
    var namespaceName = Model.Namespace;
    var enumName = Model.EnumName;
    var description = Model.Description;
    var underlyingType = Model.UnderlyingType;
    var values = Model.Values;
}
namespace @(namespaceName);

@if (!string.IsNullOrEmpty(description))
{
@Raw("/// <summary>")
@Raw("/// " + description)
@Raw("/// </summary>")
}
public enum @(enumName) : @(underlyingType)
{
@for (int i = 0; i < values.Count; i++)
{
    var value = values[i];
    @if (!string.IsNullOrEmpty(value.Description))
    {
@Raw("    /// <summary>")
@Raw("    /// " + value.Description)
@Raw("    /// </summary>")
    }
    @:@(value.Name) = @(value.ValueString)@(i < values.Count - 1 ? "," : "")
}
}
