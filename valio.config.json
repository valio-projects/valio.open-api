{
  "projects": {
    "PanoramasAdminApi": {
      "language": "Cpp",
      "schema": "https://public-api.bytalent.ru/api/chessboard/panoramas/admin/swagger/v1/swagger.json",
      "outputPath": "out/cpp/ue",
      "generateModels": true,
      "generateClients": true,
      "namespace": "Wireframe",
      "options": {
        "cpp": {
          "moduleApiMacro": "WIREFRAME_API",
          "blueprintCategory": "Wireframe|Panoramas",
          "copyright": "Copyright Epic Games, Inc. All Rights Reserved.",
          "baseAsyncActionClassName": "UValIOAsyncActionBase",
          "baseAsyncActionIncludePath": "Blueprint/ValIOTypedAsyncActionBase.h"
        }
      },
      "fileOrganization": {
        "groupingStrategy": "ByTag",
        "separateModels": true,
        "separateClients": true,
        "modelsPath": "Models",
        "clientsPath": "Api"
      },
      "namingConvention": {
        "models": "PascalCase",
        "properties": "PascalCase",
        "methods": "PascalCase",
        "enums": "PascalCase"
      }
    }
  }
}
