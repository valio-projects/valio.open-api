@using ValIO.Generators.CSharp.Models
@using ValIO.Generators.TypeScript.Models
@using ValIO.Core.Models
@using System.Collections.Generic
@using System.Linq
@model TypeScriptClientTemplateData
@functions {
    string FormatType(TypeInfo typeInfo)
    {
        return typeInfo.FullTypeName;
    }
    
    string GetResponseType(TypeInfo returnTypeInfo)
    {
        if (returnTypeInfo.IsTask && returnTypeInfo.GenericArguments.Count > 0)
        {
            return returnTypeInfo.GenericArguments[0].FullTypeName;
        }
        return returnTypeInfo.FullTypeName;
    }
    
    string FormatParameter(TypeScriptParameterTemplateData param)
    {
        var optional = param.IsRequired ? "" : "?";
        return $"{param.VariableName}{optional}: {FormatType(param.TypeInfo)}";
    }
    
    string BuildPath(string path, IReadOnlyList<TypeScriptParameterTemplateData> pathParams)
    {
        var result = path;
        foreach (var param in pathParams)
        {
            result = result.Replace($"{{{param.Name}}}", $"${{{param.VariableName}}}");
        }
        return result;
    }
}
@{
    var clientName = Model.ClientName;
    var operations = Model.Operations;
    var importedTypes = Model.ImportedTypes;
    var modelsPath = Model.ModelsPath;
    var axiosOptions = Model.AxiosOptions;
    var hasCustomInstance = axiosOptions != null && !string.IsNullOrEmpty(axiosOptions.CustomInstancePath) && !string.IsNullOrEmpty(axiosOptions.CustomInstanceName);
}
import { AxiosInstance, AxiosRequestConfig } from 'axios';
@if (hasCustomInstance)
{
@:import { @axiosOptions.CustomInstanceName } from '@axiosOptions.CustomInstancePath';
}
@if (importedTypes != null && importedTypes.Count > 0 && modelsPath != null)
{
@foreach (var typeName in importedTypes)
{
@:import type { @typeName } from '@modelsPath/@(char.ToLowerInvariant(typeName[0]) + typeName.Substring(1)).model';
}
@:
}

@foreach (var operation in operations)
{
@if (!string.IsNullOrEmpty(operation.Summary))
{
@:/**
@: * @Raw(operation.Summary)
@: */
}
@if (!string.IsNullOrEmpty(operation.Description))
{
@:/**
@: * @Raw(operation.Description)
@: */
}
    var allParams = new List<string>();
    allParams.AddRange(operation.PathParameters.Select(FormatParameter));
    allParams.AddRange(operation.QueryParameters.Select(FormatParameter));
    allParams.AddRange(operation.HeaderParameters.Select(FormatParameter));
    
    if (operation.HasRequestBody)
    {
        if (operation.IsFormData && operation.FormDataProperties != null && operation.FormDataProperties.Count > 0)
        {
            foreach (var formProp in operation.FormDataProperties)
            {
                var optional = formProp.IsRequired ? "" : "?";
                allParams.Add($"{formProp.VariableName}{optional}: {FormatType(formProp.TypeInfo)}");
            }
        }
        else
        {
            var optional = operation.RequestBodyTypeInfo != null && !operation.RequestBodyTypeInfo.IsNullable ? "" : "?";
            var typeStr = operation.RequestBodyTypeInfo != null ? FormatType(operation.RequestBodyTypeInfo) : "any";
            allParams.Add($"{operation.RequestBodyParameter}{optional}: {typeStr}");
        }
    }
    
    // Добавляем axiosInstance сразу после параметров API метода: optional если есть custom instance, обязательный если нет
    if (hasCustomInstance)
    {
        allParams.Add("axiosInstance?: AxiosInstance");
    }
    else
    {
        allParams.Add("axiosInstance: AxiosInstance");
    }
    
    // Добавляем optional signal и timeout после axiosInstance
    allParams.Add("signal?: AbortSignal");
    allParams.Add("timeout?: number");
    
    var paramsStr = "";
    if (allParams.Count > 0)
    {
        paramsStr = "  " + string.Join(",\n  ", allParams);
    }
    
@:export async function @(operation.MethodName)(
@:@Raw(paramsStr)
@:): Promise<@GetResponseType(operation.ReturnTypeInfo)> {
@:  const path = `@Raw(BuildPath(operation.Path, operation.PathParameters))`;
@:  const config: AxiosRequestConfig = {
@:    method: '@operation.HttpMethod.ToLowerInvariant()',
@:    url: path,
@if (operation.QueryParameters.Count > 0)
{
@:    params: {
@foreach (var queryParam in operation.QueryParameters)
{
@:      '@queryParam.Name': @(queryParam.VariableName),
}
@:    },
}
@:    headers: {
@foreach (var headerParam in operation.HeaderParameters)
{
@:      ...(@(headerParam.VariableName) !== undefined ? { '@headerParam.Name': @(headerParam.VariableName) } : {}),
}
@if (operation.HasRequestBody)
{
    @if (operation.IsFormData && operation.FormDataProperties != null && operation.FormDataProperties.Count > 0)
    {
@:      'Content-Type': 'multipart/form-data',
    }
    else
    {
@:      'Content-Type': '@(operation.RequestBodyContentType ?? "application/json")',
    }
}
@:    },
@if (operation.HasRequestBody)
{
    @if (operation.IsFormData && operation.FormDataProperties != null && operation.FormDataProperties.Count > 0)
    {
@:    data: (() => {
@:      const formData = new FormData();
@foreach (var formProp in operation.FormDataProperties)
{
    @if (formProp.IsRequired)
    {
@:      formData.append('@formProp.Name', @(formProp.VariableName));
    }
    else
    {
@:      if (@(formProp.VariableName) !== undefined) {
@:        formData.append('@formProp.Name', @(formProp.VariableName));
@:      }
    }
}
@:      return formData;
@:    })(),
    }
    else
    {
@:    data: @(operation.RequestBodyParameter),
    }
}
@if (hasCustomInstance)
{
@:    ...(signal !== undefined ? { signal } : {}),
@:    ...(timeout !== undefined ? { timeout } : {}),
@:  };
@:
@:  const instance = axiosInstance ?? @axiosOptions.CustomInstanceName;
@:  const response = await instance.request<@GetResponseType(operation.ReturnTypeInfo)>(config);
}
else
{
@:    ...(signal !== undefined ? { signal } : {}),
@:    ...(timeout !== undefined ? { timeout } : {}),
@:  };
@:
@:  const response = await axiosInstance.request<@GetResponseType(operation.ReturnTypeInfo)>(config);
}
var responseTypeInfo = operation.ReturnTypeInfo.IsTask && operation.ReturnTypeInfo.GenericArguments.Count > 0
    ? operation.ReturnTypeInfo.GenericArguments[0]
    : operation.ReturnTypeInfo;
var shouldReturnData = !responseTypeInfo.IsVoid;
@if (shouldReturnData)
{
@:  return response.data;
}
@:}
@:
}