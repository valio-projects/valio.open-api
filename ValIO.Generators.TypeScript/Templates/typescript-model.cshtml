@using ValIO.Generators.CSharp.Models
@using ValIO.Generators.TypeScript.Models
@using ValIO.Core.Models
@model TypeScriptModelTemplateData
@functions {
    string FormatType(TypeInfo typeInfo)
    {
        var typeName = typeInfo.FullTypeName;
        // Убираем "?" из типа, если он там есть - мы добавим его к имени свойства
        if (typeName.EndsWith("?"))
        {
            typeName = typeName.Substring(0, typeName.Length - 1).Trim();
        }
        return typeName;
    }
    
    string FormatOptional(bool isOptional, TypeInfo typeInfo)
    {
        // Если свойство опциональное, добавляем "?" к имени свойства
        // Это правильный синтаксис TypeScript: "propertyName?: type" вместо "propertyName: type?"
        return isOptional ? "?" : "";
    }
}
@{
    var interfaceName = Model.InterfaceName;
    var description = Model.Description;
    var properties = Model.Properties;
    var useStrictNullChecks = Model.UseStrictNullChecks;
    var importedTypes = Model.ImportedTypes;
    var baseClassName = Model.BaseClassName;
    var baseClassProperties = Model.BaseClassProperties;
    var ownProperties = Model.OwnProperties;
    var useIntersectionType = !string.IsNullOrEmpty(baseClassName) && ownProperties.Count > 0;
    var useTypeAlias = !string.IsNullOrEmpty(baseClassName) && ownProperties.Count == 0;
    var useZodInfer = Model.ValidationLibrary == ValidationLibrary.Zod;
    var schemaName = $"{interfaceName}Schema";
    var schemaFileName = char.ToLowerInvariant(interfaceName[0]) + interfaceName.Substring(1);
}
@if (useZodInfer)
{
    // Если используется Zod, импортируем схему и экспортируем тип через z.infer
@Raw($"import {{ {schemaName} }} from './{schemaFileName}.schema';\n")
@Raw("import { z } from 'zod';\n")
@if (!string.IsNullOrEmpty(description))
{
@Raw("/**\n")
@Raw($" * {description}\n")
@Raw(" */\n")
}
@Raw($"export type {interfaceName} = z.infer<typeof {schemaName}>;\n")
}
else
{
    // Стандартная генерация интерфейсов
@if (importedTypes != null && importedTypes.Count > 0)
{
@foreach (var typeName in importedTypes)
{
@Raw($"import type {{ {typeName} }} from './{char.ToLowerInvariant(typeName[0]) + typeName.Substring(1)}.model';\n")
}
@:
}
@if (!string.IsNullOrEmpty(description))
{
@Raw("/**\n")
@Raw($" * {description}\n")
@Raw(" */\n")
}
@if (useTypeAlias)
{
@Raw($"export type {interfaceName} = {baseClassName};\n")
}
else if (useIntersectionType)
{
@Raw($"export type {interfaceName} = {baseClassName} & {{\n")
@foreach (var property in ownProperties)
{
    @if (!string.IsNullOrEmpty(property.Description))
    {
    @:  /**
    @:   * @Raw(property.Description)
    @:   */
    }
    @:  @property.Name@FormatOptional(property.IsOptional, property.TypeInfo): @Raw(FormatType(property.TypeInfo));
}
@Raw("};\n")
}
else
{
@Raw($"export interface {interfaceName} {{\n")
@foreach (var property in properties)
{
    @if (!string.IsNullOrEmpty(property.Description))
    {
    @:  /**
    @:   * @Raw(property.Description)
    @:   */
    }
    @:  @property.Name@FormatOptional(property.IsOptional, property.TypeInfo): @Raw(FormatType(property.TypeInfo));
}
@Raw("}\n")
}
}