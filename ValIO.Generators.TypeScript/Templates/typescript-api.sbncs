{{~ for operation in operations ~}}
{{~ if operation.summary && operation.summary != "" ~}}
/**
 * {{ operation.summary }}
 */
{{~ end ~}}
export async function {{ operation.method_name }}({{ operation.parameters }}): {{ operation.return_type }} {
  return fetch("{{ operation.path }}", {
    method: "{{ operation.http_method }}",
    {{~ if operation.has_request_body ~}}
    headers: {
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({{ operation.request_body_parameter }})
    {{~ else ~}}
    headers: {}
    {{~ end ~}}
  });
}

{{~ end ~}}

