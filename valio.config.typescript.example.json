{
  "projects": {
    "ChessboardApi": {
      "language": "TypeScript",
      "schema": "http://localhost:5100/swagger/v1/swagger.json",
      "outputPath": "F:\\Workspace\\ValIO\\out\\Новаяпапка2",
      "generateModels": true,
      "generateClients": true,
      "options": {
          "Language": "typescript",
          "queryParametersStyle": "ModelClass",
          "modelFormat": "ValidationSchemas",
          "validation": "zod4",
          "transports": ["axios"],
          "queryWrapper": "tanstack-react",
          "resultTypeSuffix": "Results",
          "uuidFormat": "guid",
          "serializeWithSchemas": true,
          "deserializeWithSchemas": true,
          "enumFormat": "Enum",
          "useStrictNullChecks": true,
          "axios": {
            "customInstancePath": "@app/valioAxios.ts",
            "customInstanceName": "PanoramasValioAxiosClient"
          }
        
      },
      "fileOrganization": {
        "groupingStrategy": "by-route",
        "separateModels": true,
        "separateClients": true,
        "modelsPath": "models",
        "clientsPath": "endpoints",
        "schemasPath": "schemas"
      },
      "namingConvention": {
        "models": "PascalCase",
        "properties": "CamelCase",
        "methods": "PascalCase",
        "enums": "PascalCase"
      }
    }
  }
}
